      },
      "id": "655B062C9E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 4,
        "endOffset": 45,
        "text": "let me be clear, let's not make a mistake",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "1AED1EC231",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 46,
