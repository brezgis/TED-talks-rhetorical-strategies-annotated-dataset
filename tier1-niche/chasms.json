  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 15,
        "endOffset": 41,
        "text": "chasms so deep and so wide",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "78AA236439",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 111,
        "text": "There are some chasms so deep and so wide, we find it hard to imagine how we'll ever make it to the other side.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EBAAF90EFE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 5,
        "endOffset": 51,
        "text": "space between who we are and who we want to be",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5178816BE1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 57,
        "endOffset": 108,
        "text": "gaps between our high ideals and our base realities",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "55FE37EF4A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 109,
        "text": "That space between who we are and who we want to be, the gaps between our high ideals and our base realities.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "022BE255A6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 4,
        "endOffset": 56,
        "text": "distance between what we say and what we really mean",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A0C8B6C488",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 57,
        "text": "The distance between what we say and what we really mean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5DE759D97B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 4,
        "endOffset": 16,
        "text": "raging river",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "80CCBF2B8D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 87,
        "text": "The raging river that flows between what actually happened and our convenient memories.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BBDD633397",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 4,
        "endOffset": 36,
        "text": "lies we tell ourselves are lakes",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F0983F06BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 38,
        "endOffset": 112,
        "text": "overflowing their banks, flooding our speech with waters, caustic and rank",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F87E206938",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 113,
        "text": "The lies we tell ourselves are lakes, overflowing their banks, flooding our speech with waters, caustic and rank.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA22D51B2F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 23,
        "endOffset": 28,
        "text": "truth",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D5488295E8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 58,
        "endOffset": 91,
        "text": "as we look one another eye to eye",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7750CA1E56",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 92,
        "text": "The only bridge is the truth, passing through me and you, as we look one another eye to eye.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "281DF0217B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 97,
        "text": "But so often, that look is filled with our hesitations, and we can't help but glance to the side.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F360BE224F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 83,
        "text": "See, we've long ago let go of the language with which we describe our softer parts.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "242E31926A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 52,
        "text": "We learn early that those with softer hearts suffer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "92D9756EE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 55,
        "endOffset": 103,
        "text": "only strain has been the fruit of our restraints",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "80FBB824F3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 104,
        "text": "So we allow lean emotion to reign, never noticing that only strain has been the fruit of our restraints.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0ADB4B5BDC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 24,
        "text": "We haven't escaped pain.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6363A00A35",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 40,
        "text": "And our battle scars are far from faint.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1E9451D345",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 160,
        "text": "Yet and still, despite our desire and willingness to heal, we often find ourselves fighting hard in the paint, holding onto false images of everything we ain't.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "857C787C36",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 46,
        "text": "So while our dream coincide, our fears collide",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "617D363DAC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 47,
        "text": "So while our dream coincide, our fears collide.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3FA7E48CFF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 52,
        "text": "And we want to know one another, but think we can't.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "509EF55E82",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 52,
        "text": "And we want to know one another, but think we can't.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "84B1F09CE4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 106,
        "text": "The gulf between empathy and equity is as unfathomable as the fissures that line our collective integrity.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "952806D423",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 69,
        "text": "And we spend eternal eternities trying to translate that into virtue.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "68F49F6A31",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 61,
        "text": "Perhaps you have met one or two of the virtuous on your path.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "14287E32C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 171,
        "text": "They are only very few, and I know that I have, from time to time, mistaken pretenders for real, yet still make room for the possibility that it's I who's been pretending.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2FD7BE5D61",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 111,
        "text": "Please, bear with me, I'm still mending, but I'm no longer bending to the will of my injuries, nor my injurers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1F3C53FE44",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 65,
        "text": "I much prefer to stretch my arms like Nüt until I become the sky.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8E0ADF815D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 97,
        "text": "I'd rather stretch my tongue with truth, our bridge to cross when we look one another in the eye.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "23804C8206",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 43,
        "text": "But the tongue, like the heart, gets tired.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "78683AD657",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 171,
        "text": "The weak make it hard for the strong to stay inspired, like the lost prevent the found from escaping the mire, and the degraded stop the enlightened from taking us higher.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F5AB7A13CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 234,
        "text": "But no matter what you hear from the mouths of these liars, we are one people with one destiny and the common enemy, that's why it really stresses me to see our hearts so tattered, our minds so scattered, our egos so easily flattered.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "07200F60B1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 51,
        "text": "We're enslaved, yet think of our shackles as gifts.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "4D93314D83",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 131,
        "text": "Rather than resist our masters, we let them widen our rifts, like mindless, material junkies, we seek that which lowers, not lifts.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "77A1E4F841",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 58,
        "text": "But somewhere in our midst, there's been a paradigm shift.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A1D70962B4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 42,
        "text": "Justice is getting restless in its chains.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "176DC4C2A2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 123,
        "text": "Our youth find it useless to separate their souls from their brains, their truth is ingrained, their integrity insustained.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C8EC79E893",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 26,
        "text": "Let me call your attention",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D245F7583E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 58,
        "text": "Let me call your attention to those who serve as examples.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "455C680344",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 67,
        "text": "Those who daily give their all, but their reserves are still ample.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5394C3472B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 43,
        "endOffset": 65,
        "text": "hope is never trampled",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "63DA4ADCAB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 106,
        "endOffset": 189,
        "text": "world's ugly could never cancel the fullness and the sweetness of their composition",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "0A48D47B44",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 190,
        "text": "Those who battle friend and foe, yet their hope is never trampled, they make music, never sample, and the world’s ugly could never cancel the fullness and the sweetness of their composition.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F4A2BA9A8E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 45,
        "text": "Nor the unadulterated truth of their mission.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "423EA72D2D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 40,
        "text": "It's time we shut our mouths and listen.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "127CA89466",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 40,
        "text": "It's time we shut our mouths and listen.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "34EE83BB96",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 83,
        "text": "Close our eyes and pray for the humility and the guidance to follow them to the way",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "9B0697E86F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 84,
        "text": "Close our eyes and pray for the humility and the guidance to follow them to the way.",
        "paragraphlabels": [
