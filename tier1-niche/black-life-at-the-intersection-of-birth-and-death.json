  "lead_time": 55.262,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 35,
        "endOffset": 81,
        "text": "a poet, a Pan-Africanist and a freedom fighter",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "13F918DB72",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 65,
        "text": "I was 23 years old when I first heard about Reproductive Justice.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C4B6A11A37",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 226,
        "text": "I was working at Women with a Vision, where I learned that Reproductive Justice was defined by Sister Song as: One: A woman's right to decide if and when she will have a baby and the conditions under which she will give birth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5A676B39F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 112,
        "text": "Two: A woman's right to decide if she will not have a baby and her options for preventing or ending a pregnancy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E5704D2EA3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 159,
        "text": "And three: A woman's right to parent the children she already has in safe and healthy environments without fear of violence from individuals or the government.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6523AAEAC4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 34,
        "text": "I've always wanted to be a mother.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1ED3657B86",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 53,
        "text": "Growing up, I heard all about the joys of motherhood.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "559562AE69",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 31,
        "endOffset": 64,
        "text": "womb weave wonder into this world",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "092388FCA2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 24,
        "text": "See, I knew I was young.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "19F7604462",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 81,
        "text": "But I figured, it couldn't hurt to start planning for something so big, so early.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "88468A435B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 26,
        "text": "But now, I'm 26 years old.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F43F6639D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 79,
        "text": "And I don't know if I have what it takes to stomach motherhood in this country.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8DE2AF6839",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 21,
        "endOffset": 92,
        "text": "America has taught me more about parenting than any book on the subject",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5A1C06058F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 46,
        "endOffset": 75,
        "text": "babies and others to suspects",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2650D2DCC9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 43,
        "endOffset": 122,
        "text": "kin who are more likely to be held in prison cells than to hold college degrees",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "858022B450",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 9,
        "endOffset": 47,
        "text": "something about being Black in America",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "7A2774BA6A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 90,
        "text": "There is something about being Black in America that has made motherhood seem complicated.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5E41870548",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 78,
        "text": "Seem like, I don't know what to do to raise my kids right and keep them alive.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E4F2261843",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 16,
        "text": "Do I tell my son",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "117BE72BD6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 100,
        "text": "Do I tell my son not to steal because it is wrong, or because they will use it to justify his death?",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "4FFC099B67",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 13,
        "text": "Do I tell him",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "97944D36B3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 115,
        "endOffset": 142,
        "text": "see a criminal before child",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "21506603C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 199,
        "text": "Do I tell him that even if he pays for his Skittles and sweet tea there will still be those who will watch him and see a criminal before child; who will call the police and not wait for them to come.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7B568FC225",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 34,
        "text": "Do I even want the police to come?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "5F47208E7C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 9,
        "endOffset": 37,
        "text": "Sean Bells go off in my head",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "62CE226A51",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 66,
        "text": "Too many Sean Bells go off in my head when I consider calling 911.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7C7DF06706",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 23,
        "endOffset": 37,
        "text": "Oscar Grant-ed",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3D0A38C6D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 78,
        "text": "I will not take it for Oscar Grant-ed that they will not come and kill my son.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A50542901E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 66,
        "endOffset": 74,
        "text": "lynching",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "AB24B538DC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 152,
        "text": "So, we may have gotten rid of the nooses, but I still consider it lynching when they murder Black boys and leave their bodies for four hours in the sun.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "019EB8FBE0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 103,
        "endOffset": 122,
        "text": "sound like mourning",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2F38AC13E8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 123,
        "text": "As a historical reminder that there is something about being Black in America that has made motherhood sound like mourning.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C468541304",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 87,
        "text": "sound like one morning I could wake up and see my son as a repeat of last week's story.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8B076D345F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 87,
        "text": "Sound like one morning I could wake up and see my son as a repeat of last week's story.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D7B09A4617",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 92,
        "text": "Sound like I could wake up and realize the death of my daughter wouldn't even be newsworthy.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E06A3B0618",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 92,
        "text": "Sound like I could wake up and realize the death of my daughter wouldn't even be newsworthy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "39D2ABB91F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 20,
        "text": "So you can't tell me",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0D5778F217",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 109,
        "text": "So you can't tell me that Sandra Bland is the only Black woman whose violence deserves more than our silence.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2D14841A0E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 43,
        "text": "What about our other dark-skinned daughters",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "770ADB4350",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 93,
        "text": "What about our other dark-skinned daughters in distress whose deaths we have yet to remember?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A69EC912D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 23,
        "text": "What about our children",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "665AA0BDFC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 87,
        "text": "What about our children whose lives don't fit neatly between the lives of your genders?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "82348962F2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 17,
        "endOffset": 45,
        "text": "nothing is a great protector",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "19608D946A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 93,
        "text": "See, apparently, nothing is a great protector if you come out of a body that looks like this.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "11C8A0B60A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 78,
        "endOffset": 129,
        "text": "sound like something I'm not sure I look forward to",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1BB9E45FCC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 77,
        "text": "See, there is something about being Black in America that has made motherhood",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8E3AEB4038",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 5,
        "endOffset": 53,
        "text": "written too many poems about dead Black children",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5499A5AE76",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 138,
        "text": "I've written too many poems about dead Black children to be naïve about the fact that there could one day be a poem written about my kids.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7053F2FA4D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 57,
        "text": "But I do not want to be a mother who gave birth to poems.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "01881253DA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 33,
        "endOffset": 88,
        "text": "nor a line for a little girl nor a footnote for a child",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "BE2FC126D6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 32,
        "text": "I do not want a stanza for a son",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EDB1F57BB7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 3,
        "text": "No.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D0D1AC5D9D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 98,
        "text": "I do not want children who will live forever in the pages of poetry, yet can't seem to outlive me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C824E6DF97",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 70,
        "text": "(Applause) I was invited to the TEDWomen conference to perform a poem.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "96A172668E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 52,
        "text": "But for me, poetry is not about art and performance.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "77EAB88941",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 24,
        "text": "It is a form of protest.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9BF7191342",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 115,
        "text": "Yesterday, during rehearsal, I was told that there had been two to three recent TED Talks about Black Lives Matter.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6B30AA5AC1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 90,
        "text": "That maybe I should cut down my TED Talk so it could \"just\" be about Reproductive Justice.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "253C4237F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 84,
        "text": "But that poem and this talk is fundamentally about my inability to separate the two.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D79285BC1C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 85,
        "text": "I was 21 years old -- (Applause) I was 21 years old when Trayvon Martin was murdered.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B65DFB5A83",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 56,
        "endOffset": 130,
        "text": "reminded me reminded us how little this nation actually values Black life.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E17A07CDB9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 55,
        "text": "Trayvon Martin, a 17-year-old Black boy, a Black child,",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "920A5E3206",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 220,
        "text": "The hashtag #BlackLivesMatter became the most recognized call for Black people and our children to live in safe environments and healthy communities without fear from violence from individuals or the state or government.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "701D67BEAF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 146,
        "text": "Months later, when George Zimmerman was not held responsible for murdering Trayvon Martin, I heard Sybrina Fulton, Trayvon Martin's mother, speak.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FD5297A652",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 17,
        "endOffset": 35,
        "text": "deeply impacted me",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A3CB860E75",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 67,
        "endOffset": 93,
        "text": "asking, what would it mean",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "8C02233370",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 32,
        "text": "What does motherhood really mean",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "9619FC2360",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 74,
        "endOffset": 98,
        "text": "synonymous with mourning",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5A2169662B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 110,
        "text": "Without realizing it, I had begun to link the Reproductive Justice framework and the Movement for Black Lives.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B957504183",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 199,
        "text": "As I learned more about Reproductive Justice at Women With A Vision, and as I continued to be active in the Movement for Black Lives, I found myself wanting others to see and feel these similarities.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "827AE06311",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 23,
        "endOffset": 38,
        "text": "Whose job is it",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "927926C26B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 64,
        "text": "I want to dedicate this talk and that poem to Constance Malcolm.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "767ED50F7A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 100,
        "text": "She is the mother of Ramarley Graham who was another Black child who was murdered before their time.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4BB1DBED41",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 150,
        "endOffset": 181,
        "text": "shovels of complacency and time",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "58E77A9723",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 182,
        "text": "She reminded me once over dinner, as I was struggling to write that poem, that it is the artist’s job to unearth stories that people try to bury with shovels of complacency and time.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2F6FD51D78",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 94,
        "text": "Recently, Toni Morrison wrote, \"In times of dread, artists must never choose to remain silent.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "375D1BF2AC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 49,
        "text": "There is no time for self-pity, no room for fear.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EDFA5EC7A6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 152,
        "text": "when I was told that I should \"maybe cut the Black Lives Matter portion from my talk\"",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E9B7C55C27",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 152,
        "text": "Yesterday, during rehearsal, when I was told that I should \"maybe cut the Black Lives Matter portion from my talk,\" I found myself fearful for a moment.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "59238AE067",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 92,
        "text": "Fearful that again our stories were being denied the very stages they deserve to be told on.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "38143F0976",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 50,
        "text": "And then I remembered the words I had just spoken.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "655766E4CF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 63,
        "text": "\"In times of dread, artists must never choose to remain silent.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A54BEB3F2F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 31,
        "text": "There is no time for self-pity.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5E8EBD89D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 42,
        "text": "(Applause) There is no time for self-pity.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "15A9A4CE1D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 21,
        "text": "And no room for fear.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "792AD7ED1E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 26,
        "text": "And I have made my choice.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "322F98B2FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 25,
        "text": "And I am always choosing.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "C438436475",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 10,
        "text": "Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "882C6131EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F0F61FA817",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}