      "id": "A694B6481A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 30,
        "text": "And they are very sustainable.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B5959A74DE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 60,
        "text": "They can easily be productive at least for another 50 years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FDFC9BE8C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 90,
        "text": "Yet the government decided to come up with massive food estates on sugar cane plantations.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C4DCD0E30D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 57,
        "text": "So let's deep dive into an example of ube or greater yam.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E21887B6F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Ube can be found in the wild.",
