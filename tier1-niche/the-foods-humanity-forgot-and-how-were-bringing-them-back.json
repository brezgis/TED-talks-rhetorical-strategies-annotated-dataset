      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 113,
        "text": "So actually there is no need for one-fits-all diet, because each of these landscapes have their own food sources.",
