      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 135,
        "text": "Oh, who can understand her, this winding Niger river of a woman one who is unafraid to tear away only to roam and then become the wind.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "D56B69751B",
      "from_name": "label",
      "to_name": "text",
