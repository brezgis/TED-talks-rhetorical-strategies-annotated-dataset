        ]
      },
      "id": "A13B694048",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 46,
        "text": "Just watch their ways, how they rip and shred.",
        "paragraphlabels": [
          "INCOMPLETE"
