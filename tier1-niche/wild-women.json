      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 122,
        "text": "She who speaks in gusts and cyclones blasting us back to high ground, high consciousness, she turns and so does the world.",
        "paragraphlabels": [
