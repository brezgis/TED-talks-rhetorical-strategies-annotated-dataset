    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 24,
        "endOffset": 79,
        "text": "what you eat is more than tastes, trends and nutrition?",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E8B8B604A1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 41,
        "endOffset": 55,
        "text": "modern hungers",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "12FFBCE1A6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
