    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 61,
        "endOffset": 76,
        "text": "deepest desires",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "16E57E4BE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 81,
        "endOffset": 95,
        "text": "greatest needs",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5E3D7843DA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 26,
        "text": "Also dreams of our future.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9356F13846",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 27,
        "text": "Kids are our future, right?",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "632E9AD06C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 74,
        "endOffset": 90,
        "text": "taste the future",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "DFEF1B038B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 15,
        "endOffset": 33,
        "text": "reveals our values",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "38432ED61E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 41,
        "text": "How we're eating is eating up our worlds.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "00E23ABA7E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 37,
        "text": "I'm June Jo Lee, a food ethnographer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3A5C234CF3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 26,
        "text": "Tell me what's good to eat",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "1CDBAF53F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 27,
        "endOffset": 60,
        "text": "so I can see who you're becoming.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "70023539E7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 67,
        "text": "And if I know who you're becoming, I'll know what you'll be eating.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "011F67B0B7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 11,
        "endOffset": 17,
        "text": "portal",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A2ABB0A9DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 43,
        "text": "Join me to decode Gen Z, born 1997 to 2012.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "099C855F92",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 70,
        "text": "How they talk about food is unlike any generation I've studied before.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "13B752A1DB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 22,
        "text": "My approach is simple.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3ABE254B54",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 8,
        "endOffset": 32,
        "text": "What’s delicious to you?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7FE680BEA1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 32,
        "text": "What feeds your life?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0E12A9B241",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 23,
        "endOffset": 44,
        "text": "Like any relationship",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "615BFE6E03",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 115,
        "text": "It's founded on respect, and it’s 95 percent listening with great care and can be done over a shared meal or snack.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "50A626A239",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 38,
        "text": "Why do I care so much about this work?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A6FD31DAAE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 50,
        "text": "Because I almost lost my own Gen Zer, my son Blue.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0E7FBA288E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 73,
        "text": "He'd stopped talking to me by middle school, and in 2018, I got the call.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B33F5CCE02",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 28,
        "text": "\"Mom, I'm not doing so well.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3A12F3EE75",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 28,
        "text": "I need help.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "09110BA551",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 13,
        "text": "And the only thing I had to save my son was my work, my ethnography.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B76063569A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 68,
        "text": "You see,",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "55168DE5D4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 9,
        "endOffset": 34,
        "text": "I used to be a tiger mom.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "92960048EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 69,
        "text": "I thought being a mom meant to tell my son who to become, what to do.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C6FD725035",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 45,
        "text": "I never asked him who he was, what he wanted.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "076F27C5A9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 28,
        "text": "He told me: “You exhaust me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "882AC7907D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 28,
        "text": "You think I’m in your head”",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BCB9812D32",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 28,
        "endOffset": 47,
        "text": "And he asked me ...",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7C9042B529",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 1,
        "endOffset": 64,
        "text": "Why don't you just treat me like your ethnography, not your son",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B18B7E4D08",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 15,
        "text": "Ethnog me, Mom.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3BEF5E02D3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 57,
        "text": "(Laughter) And -- (Sighs) In that moment, my heart broke.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A2C5F1D604",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 14,
        "endOffset": 37,
        "text": "I ethnogged my own son.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "EF129EB171",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 15,
        "text": "I asked him ...",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1CB8035FA3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 1,
        "endOffset": 32,
        "text": "What's your unforgettable bite?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "031CB22E7C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Your tricky mouthful?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "4BFA96F719",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 36,
        "text": "How does it feel to be in the world?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "C45BED22C9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 17,
        "endOffset": 179,
        "text": "I feel like I'm just learning to surf, on the edge of crashing into the waves and plunging into the water and not being able to breathe or know if I'm up or down.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FA157FD1E1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 44,
        "text": "But maybe someday, I'll get good at surfing.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2D12987EF5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 52,
        "text": "Gen Z, like Blue, are open, fluid, queer by default.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "9A4C33F9DC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 62,
        "text": "They are globally connected, hyper-self-aware, and data-based.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "BA7CB2CA5D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 28,
        "text": "They are feeling everything.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CCA1252BB7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 31,
        "text": "Digital devices are nourishing.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "385C730A33",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Digital is also disorienting.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0D60A6F32E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 85,
        "text": "Gen Z are our power users of the future, learning to ride the waves of a chaotic era.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "34E7E3D9FA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 55,
        "text": "I can learn how to make kimchi, pao cai and sauerkraut.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9452B5C666",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 7,
        "endOffset": 18,
        "text": "like Olivia",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A0CB714CEC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 80,
        "text": "Gen Z, like Olivia, are learning to care more about what they eat and don't eat.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B2ABE5F857",
      "from_name": "label",
