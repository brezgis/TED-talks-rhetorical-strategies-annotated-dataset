        ]
      },
      "id": "59C1C83692",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Who's it going to be?",
        "paragraphlabels": [
