      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 73,
        "text": "All of you, with your creativity, your participation, helped create this.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A6B29DBF5B",
      "from_name": "label",
      "to_name": "text",
