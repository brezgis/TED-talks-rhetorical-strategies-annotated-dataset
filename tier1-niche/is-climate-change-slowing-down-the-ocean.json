{
  "project_id": 20,
  "project_label": "gemma",
  "task_id": 8004,
  "title": "Is climate change slowing down the ocean?",
  "author": "Susan Lozier",
  "url": "https://www.ted.com/talks/susan_lozier_is_climate_change_slowing_down_the_ocean",
  "annotation_id": null,
  "completed_by": 7,
  "created_at": "2026-05-07T04:48:18.432023Z",
  "updated_at": "2026-05-07T04:48:18.432023Z",
  "lead_time": 64.937,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 35,
        "endOffset": 46,
        "text": "telling you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "90C0183E27",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 78,
        "text": "Adelard compiled a list of unanswered questions near the end of his long life.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2FE64B4D45",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 74,
        "endOffset": 98,
        "text": "an oceanographer like me",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "DFE178C655",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 42,
        "text": "Whence comes the ebb and flow of the tide?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "140B71E4E6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 66,
        "text": "And why does the ocean not increase from the influx of the rivers?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "65BC7D51F9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 57,
        "text": "Nine centuries later, oceanographers are asking questions",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "7503B96D74",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 71,
        "text": "How will navigation routes change as sea and land ice continue to melt?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1B3A554713",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 57,
        "text": "How are marine ecosystems faring in these warming waters?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B578F4B046",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 81,
        "text": "And, will climate change cause the collapse of the ocean overturning circulation?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C5B9B7B15F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 28,
        "text": "If that last one puzzles you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "40DD430EE7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 40,
        "text": "Ocean waters are constantly on the move.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4C46A80FC9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 84,
        "endOffset": 96,
        "text": "you see here",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E6751BD56B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 126,
        "text": "But the ocean is also home to large currents that travel from one ocean basin to the next, often thousands of kilometers away.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2524150BD6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 118,
        "text": "“ocean overturning circulation”",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6193AE82BE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 103,
        "text": "In the winter, when cold winds blow across the ocean, warm surface waters are converted to cold waters.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7E8062801C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 11,
        "endOffset": 36,
        "text": "orange arrow turning blue",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "CA32A19321",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 148,
        "endOffset": 162,
        "text": "ribbon of blue",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "92B0DCF0BB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 83,
        "text": "Eventually these waters upwell, meaning they return to the surface where they warm.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D447FFEA88",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 15,
        "endOffset": 47,
        "text": "blue ribbon turns back to orange",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3A3F7EFDD7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 61,
        "text": "Now, this ocean overturning redistributes heat on our planet.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6E23C61414",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 144,
        "text": "In partnership with the atmospheric circulation, this fluid movement maintains a 30-degree-Celsius difference between the equator and the poles.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9F011BB535",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 90,
        "endOffset": 129,
        "text": "not just over the ocean, inland as well",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "C2A4D86801",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 108,
        "text": "Polar latitudes would be completely frozen, and the tropics, well the tropics would be even more sweltering.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5DA94D87FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 165,
        "text": "But this overturning also impacts our climate because when those waters sink, they carry with them the carbon dioxide they've gained by exchange with the atmosphere.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2E9828CE4E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 7,
        "endOffset": 58,
        "text": "as a result of this, as the decades have progressed",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "26F3F41565",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 129,
        "text": "In fact, the ocean now stores 30 percent of the carbon dioxide released by humanity since the start of the Industrial Revolution.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4DF5EABA39",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 130,
        "text": "Now, this does mean that the levels of carbon dioxide in the atmosphere are less than they would be otherwise, which is good news.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "13389BBF2E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 135,
        "text": "But that carbon uptake by the ocean increases ocean acidity, which is not good news for marine species that build skeletons and shells.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9236433696",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 67,
        "text": "And it is certainly not good news for marine ecosystems in general.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5EC89BA4D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 225,
        "text": "Now, as our ocean continues to warm and as ice continues to melt, both of which cause surface waters to become less dense, we fully expect that at some point, in winter, those surface waters will not get dense enough to sink.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "23CCA528FD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 53,
        "text": "And at that point, we expect the overturning to slow.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D3BA6620DB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 28,
        "text": "And if the overturning slows",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "63B5E63E85",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 82,
        "text": "And if the overturning slows, well, there will be less carbon uptake by the ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5CCA0E5CF2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 33,
        "endOffset": 50,
        "text": "major disruptions",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B20C52CBEC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 155,
        "text": "But there will also be even more major disruptions to our climate and weather patterns; we can expect stronger hurricanes, even more intense precipitation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6E1BA8D929",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 16,
        "endOffset": 38,
        "text": "you might be wondering",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "98F678495B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 81,
        "text": "Just about now, you might be wondering, how quickly might the overturning change?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E8EDF02D4C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 157,
        "text": "Well, for decades, oceanographers assumed that the overturning changed slowly on the time scales of tens of thousands of years, in concert with the ice ages.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2CA4523BFE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 196,
        "text": "But a study in the 1990s of ice sheets, which hold bubbles of air from past climates, well, that study suggested that the overturning could change quickly, within decades, maybe even within years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "622A6DDA18",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 123,
        "text": "And with that, the possibility of an abrupt collapse of the overturning circulation brought about by human-induced warming?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "70E2D9BF1E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 54,
        "text": "Well, at that point it became a very real possibility.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C5B8E3589E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 87,
        "text": "Thankfully, advances in climate modeling give us a much better idea today of that risk.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8F561BC17A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 30,
        "endOffset": 37,
        "text": "you see",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "071A67538A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 132,
        "text": "The black and gray lines that you see on this graph are the model reconstructions of the past relatively steady overturning changes.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EE82808057",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 33,
        "endOffset": 36,
        "text": "you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "C7B654711C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 146,
        "text": "The lines of various colors show you the future projections of the overturning, based on different climate models and different climate scenarios.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "468D68BB9D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 38,
        "text": "I'm going to start with the good news.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6FF93A2EAD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 78,
        "text": "And the good news is that the overturning is unlikely to collapse before 2100.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "787AE099AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 124,
        "text": "Now, before anybody breathes a sigh of relief, I will remind you that our children, our grandchildren, will likely see 2100.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "81366C1910",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 143,
        "text": "And really, none of us are out of the woods because the overturning is likely to weaken over this century by between 11 percent and 34 percent.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FF2F4D6A54",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 79,
        "text": "And that weakening is enough to cause the disruptions that I mentioned earlier.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6B79D817E6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 41,
        "text": "Now back to those various lines of color.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9A6A48B7C4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 104,
        "text": "All future projections show a decline, but they differ in how fast and by how much that decline will be.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5AE588631D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 114,
        "text": "And this is exactly where observations come in, because the longer we measure, the better our predictions will be.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E732A1EC06",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 65,
        "endOffset": 86,
        "text": "way ahead of the game",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "1EE60BF836",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 87,
        "text": "If Adelard had started measuring nine centuries ago, we would be way ahead of the game.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E96792A85F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 121,
        "text": "Unfortunately, we only started measuring in this century when we had the resources and, frankly, the motivation to do so.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5234E64B28",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 89,
        "text": "One of those efforts is an international observing system in the subpolar North Atlantic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D973EAB1E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 154,
        "text": "OSNAP stretches from the Labrador coast to one side of Greenland, and then again from the other side of Greenland, all the way over to the Scottish coast.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "700538F68D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 6,
        "endOffset": 17,
        "text": "red ribbons",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "028EF4EA65",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 57,
        "endOffset": 74,
        "text": "dark blue ribbons",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5AE5F92068",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 137,
        "text": "Those red ribbons depict the surface currents, and those dark blue ribbons depict the deep currents of the ocean overturning circulation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4136F753E5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 262,
        "text": "Every black vertical line you see is the mooring that stretches from the sea surface to the sea floor, upon which instruments, shown as red dots, those instruments are on those moorings, and they're measuring the ocean currents, the temperature and the salinity.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "A293160D2B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 136,
        "text": "Every other summer since 2014, research vessels like this one have traced the OSNAP line, deploying instruments and taking measurements.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "00665BC99D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 82,
        "text": "Dozens of oceanographers from many different countries have been on these cruises.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A9BD9FA741",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 144,
        "text": "Here's a former student of mine off the coast of Greenland, bringing in a rosette of bottles that have captured water samples in the deep ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8F24408200",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 159,
        "text": "OSNAP also allows us to use new technology, like this autonomous glider that, once deployed, will set off on a programmed course, taking measurements at depth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9CF6A9A262",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 106,
        "text": "Every now and again, this glider will pop to the surface and relay its information to a passing satellite.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "19318961FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 155,
        "endOffset": 164,
        "text": "a godsend",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D20F76534D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 20,
        "text": "You could be sitting",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "62282AFCB8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 11,
        "endOffset": 90,
        "text": "However, it is true that conditions on these cruises are sometimes challenging.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "88A37A0A6A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 59,
        "text": "But I must admit that the views are almost always worth it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA092B3A83",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 17,
        "text": "Now, you can tell",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "16564633CD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 52,
        "endOffset": 93,
        "text": "cannot tell what the stock market will do",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "55BDE24D98",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 107,
        "endOffset": 148,
        "text": "looking at the Dow Jones Industrial Index",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "88FAEDB977",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 48,
        "endOffset": 63,
        "text": "you cannot tell",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D9AB0BF18A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 9,
        "endOffset": 62,
        "text": "noise in the market, and there is noise in the ocean.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5ED92841A4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 4,
        "endOffset": 144,
        "text": "just as we have confidence that stocks are a good bet in the long run, we have confidence that in the long run, the overturning will decline",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "D87D6EF56E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 100,
        "text": "And with that confidence, we know that it's not enough for us to study the overturning in isolation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C35FCEFC87",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 115,
        "text": "We need to understand how the overturning is impacting and being impacted by everything else going on in the ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EAF53D62EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 0,
        "endOffset": 15,
        "text": "I just told you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "483DF949EC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 34,
        "text": "Well, the ocean is also connected.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6EB3864454",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 82,
        "text": "What's happening in one part of the ocean affects what's going on in another part.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "53BC594E8D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 146,
        "text": "And so to understand and to improve our estimates of the overturning, the warming, the freshening, the acidification, we need to measure globally.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7F112F13E1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 11,
        "text": "And we are.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0F1436DFEF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 99,
        "text": "This NOAA buoy is out there, measuring the exchange of carbon between the ocean and the atmosphere.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8688A30F29",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 75,
        "endOffset": 90,
        "text": "looks like this",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8DF755869C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 74,
        "text": "This one buoy is but a small part of a vast global measurement system that",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "769E84D9C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 18,
        "endOffset": 25,
        "text": "you see",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3E70E0D359",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 120,
        "text": "Every line or dot you see on this map is where there is a ship, a mooring or buoy out in the ocean, taking measurements.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "64DAED681B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 69,
        "text": "This multinational effort is the backbone of 21-century oceanography.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "546FB419F0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 0,
        "endOffset": 67,
        "text": "But we can do all those measurements of many things in many places.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "85938622FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "79",
        "end": "79",
        "startOffset": 16,
        "endOffset": 78,
        "text": "warming, the freshening, the acidification, the sea level rise",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "C20E33CBA8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "79",
        "end": "79",
        "startOffset": 0,
        "endOffset": 173,
        "text": "But to stem the warming, the freshening, the acidification, the sea level rise and to reduce the very real risk of an overturning slowdown or shutdown, there's one solution.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "66D85D1FDC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "80",
        "end": "80",
        "startOffset": 0,
        "endOffset": 73,
        "text": "We must work collectively to reduce the carbon dioxide in our atmosphere.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AE56CD8CB6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "81",
        "end": "81",
        "startOffset": 0,
        "endOffset": 105,
        "text": "Adelard did not have everything figured out in the 12th century, and we certainly don't here in the 21st.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DD7FB21990",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "82",
        "end": "82",
        "startOffset": 0,
        "endOffset": 60,
        "text": "Answers to Adelard's questions were centuries in the making.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C583F86E34",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "83",
        "end": "83",
        "startOffset": 0,
        "endOffset": 70,
        "text": "But to figure everything out on our end, we don't have nine centuries.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4FD951E044",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "84",
        "end": "84",
        "startOffset": 0,
        "endOffset": 27,
        "text": "We don't have nine decades.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "68E5F76C32",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "85",
        "end": "85",
        "startOffset": 0,
        "endOffset": 50,
        "text": "We probably have about nine years to get it right.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "64346D66A7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "86",
        "end": "86",
        "startOffset": 59,
        "endOffset": 76,
        "text": "all hands on deck",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "AC73025B2C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "86",
        "end": "86",
        "startOffset": 0,
        "endOffset": 58,
        "text": "And to get it right, it's just like everyone says, we need",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6B9CDBB1BE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "87",
        "end": "87",
        "startOffset": 0,
        "endOffset": 10,
        "text": "Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "684E7ACC46",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "88",
        "end": "88",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FB17DCCF50",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}