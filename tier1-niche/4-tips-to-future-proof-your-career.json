        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "84F7CCAE9C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 9,
        "endOffset": 39,
        "text": "your experience as a caregiver",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "2FF4E2205D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 37,
        "text": "Human skills are deeply transferable.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "00970DFB04",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 27,
        "text": "You might surprise yourself",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "24C9D0224F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 35,
        "text": "Second, become a skills translator.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "141F9858A2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 21,
        "text": "You need to translate",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "9CE4D287BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 127,
        "text": "Research the industry you want to move into because the same skill can have vastly different meanings depending on the context.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B93DE432C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 140,
        "endOffset": 171,
        "text": "storytelling or branding skills",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "832811F68F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 14,
        "endOffset": 49,
        "text": "when a marketing position is asking",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A04F0E39CC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 123,
        "endOffset": 154,
        "text": "counseling or crisis management",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2E69F50D47",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 4,
        "endOffset": 46,
        "text": "when a behavioral health position mentions",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "B035CB7196",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 24,
        "text": "Become their translator.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "18985730E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 31,
        "text": "Third, find data in discomfort.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2BECBA21AE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 40,
        "text": "At work, when do you feel uncomfortable?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "5D97924FD9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 15,
        "endOffset": 27,
        "text": "out of depth",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FCBED3E5E9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 14,
        "text": "Maybe you feel",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CAFB4826C1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 31,
        "text": "Pay attention to those signals.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A540A33E3D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 32,
        "text": "That kind of discomfort is good.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DC41AFD9FD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 49,
        "text": "It's data telling you where you need to level up.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "ED5062B09A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 76,
        "text": "Sign up for a course to get up to speed on that new platform or application.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "89B65925C8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 62,
        "text": "Transform that discomfort around your skills gaps into action.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8C27E5378E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 19,
        "text": "Finally, get picky.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C5A9C4C890",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 66,
        "text": "You shouldn't be the only one committed to your skill development.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "DBA174246C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 28,
        "text": "Your employer should be too.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "5B6A09710B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 107,
        "text": "The next time you change jobs, try to choose a company or organization that is building talent from within.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1A69E612A9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 65,
        "text": "Look at LinkedIn and see if people have risen within the company.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CF1659B2F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 84,
        "text": "Ask during the interview whether there are clear road maps for internal advancement.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "43D2BBD0EA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 186,
        "text": "The reality is, most companies have so much work to do when it comes to recognizing human skills, spotting talent in unexpected places and cultivating the careers of their own employees.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "894F3BFEBA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 111,
        "text": "You want an employer that takes the long view on your career and can help you fill your skills gaps on the job.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A34BE0C85E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 59,
        "endOffset": 192,
        "text": "you can take control, you can steer the process, you can surface your hidden skills, translate your strengths and level up your gaps.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "93AB69D1C1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 72,
        "text": "You can show employers new ways to think about why they should hire you.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A80A918E12",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 15,
        "text": "And when you do",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7E7521F75A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 59,
        "endOffset": 88,
        "text": "a whole lot less intimidating",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "EB66E3F560",
