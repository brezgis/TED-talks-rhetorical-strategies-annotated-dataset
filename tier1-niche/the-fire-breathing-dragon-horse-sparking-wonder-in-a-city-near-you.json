    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 105,
        "text": "And now he’s asleep in front of the city hall, and people on their way to work hear the creature snoring.",
        "paragraphlabels": [
