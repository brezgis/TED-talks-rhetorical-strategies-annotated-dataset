      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 44,
        "text": "Spitting fire, smoke coming out of his body.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0DEDBEC2E4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
