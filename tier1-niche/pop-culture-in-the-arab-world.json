        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5CE80BE1F3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 47,
        "endOffset": 67,
        "text": "I've got to tell you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D703D0D88E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 63,
        "text": "My experience, however, in the Islamic world is very different.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9463C84456",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 187,
        "text": "root of the problem",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "DCC0726DD8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 187,
        "text": "Where I work, in the Arab region, people are busy taking up Western innovations and changing them into things which are neither conventionally Western, nor are they traditionally Islamic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9BB6B7B2BC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 32,
        "text": "I want to show you two examples.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7132509F54",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 20,
        "text": "The first is 4Shbab.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0C19BEC2C4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 52,
        "text": "It means \"for youth\" and it's a new Arab TV channel.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9278642677",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 43,
        "text": "(Video): Video clips from across the globe.",
        "paragraphlabels": [
          "NONE"
        ]
      },
