          "NONE"
        ]
      },
      "id": "9AADDB1C20",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 66,
        "text": "They were created by a Kuwaiti psychologist called Naif Al Mutawa.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D8CC853E9E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 21,
        "endOffset": 60,
        "text": "rescue Islam from images of intolerance",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A48B3E8623",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 20,
        "text": "And his desire is to",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "21AD48A8F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 62,
        "endOffset": 93,
