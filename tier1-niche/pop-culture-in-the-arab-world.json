      },
      "id": "945CA0E67B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 118,
        "text": "Now, according to proponents of the clash of civilizations, Barbie and Fulla occupy these completely separate spheres.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "66D18C7CE8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 30,
        "text": "They have different interests.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "85DADFD0BB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 27,
        "text": "They have divergent values.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "4553CF6597",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
