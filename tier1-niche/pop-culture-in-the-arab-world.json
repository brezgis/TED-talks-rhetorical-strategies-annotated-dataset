      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 11,
        "endOffset": 43,
        "text": "I am not afraid to stand alone ♫",
        "paragraphlabels": [
          "REP"
        ]
      },
