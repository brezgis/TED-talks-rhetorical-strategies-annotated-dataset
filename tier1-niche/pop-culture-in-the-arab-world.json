      "id": "D9F367D6CE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 113,
        "text": "Its videos are intended to show a kinder, gentler face of Islam, for young people to deal with life's challenges.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D2FFC996C8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 55,
        "text": "Now, my second example is for a slightly younger crowd.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "28F0BAF6BB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 25,
        "text": "And it's called \"The 99.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "52580B12E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 53,
        "text": "Now, these are the world's first Islamic superheroes.",
