      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 23,
        "text": "How does the reef work?",
        "paragraphlabels": [
          "ENG"
