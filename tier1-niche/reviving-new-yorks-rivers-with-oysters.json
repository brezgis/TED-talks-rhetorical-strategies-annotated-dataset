      "id": "38AB415674",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Well, it's very, very simple.",
        "paragraphlabels": [
