      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 121,
        "text": "And with a $20 billion price tag, we should simply start and get to work with what we have now and what's in front of us.",
        "paragraphlabels": [
