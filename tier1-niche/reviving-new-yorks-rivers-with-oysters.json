    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 109,
        "endOffset": 152,
        "text": "rich, three-dimensional mosaic to flat muck",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "5B54AB5C8E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 181,
        "text": "But you can see, even just intuit, from this map, that the harbor has dredged and flattened, and went from a rich, three-dimensional mosaic to flat muck in really a matter of years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C715E38B47",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 58,
        "text": "Another set of views of actually the Gowanus Canal itself.",
        "paragraphlabels": [
          "NONE"
