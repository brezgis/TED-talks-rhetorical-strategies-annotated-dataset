        ]
      },
      "id": "0F01FE683C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 106,
        "text": "So this image is simply showing -- it's a field of marine piles interconnected with this woven fuzzy rope.",
