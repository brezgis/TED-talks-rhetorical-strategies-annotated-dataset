    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 55,
        "endOffset": 73,
        "text": "we have to imagine",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D33AB318D5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
