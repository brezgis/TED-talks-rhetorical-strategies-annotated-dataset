    },
    {
      "value": {
        "start": "83",
        "end": "83",
        "startOffset": 78,
        "endOffset": 153,
        "text": "the silence that holds a friend's words in place that says they hear it too",
        "paragraphlabels": [
          "FIG"
        ]
