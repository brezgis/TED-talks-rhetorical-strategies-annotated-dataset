      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 13,
        "endOffset": 29,
        "text": "The Solar System",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "Am0RYZNLFP",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 164,
        "text": "Now, this water-drip system works by matching the water tanks on one side of the solar panel to the force and strength applied by a spring system on the other side.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "PBN3Zg5D4S",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 134,
        "text": "Now, this means that I'm able to control the drip amount and slowly rotate the panel throughout the day, matching the path of the Sun.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "OxKg7yA_tY",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 182,
        "text": "The Solar System could be an exciting tool for developing communities as it's able to provide both water and power by filtering the water once it comes out of this water-drip system.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "tHsOeqbMJU",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 97,
        "text": "We can provide developing communities with a safe access, a safe reliable water source and power.",
        "paragraphlabels": [
