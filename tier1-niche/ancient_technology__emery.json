    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 51,
        "endOffset": 60,
        "text": "solutions",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "jeisX2hSBI",
