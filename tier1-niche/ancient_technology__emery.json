    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 139,
        "text": "Now, I want to change your focus to a modern-day oncology unit, specifically women who are undergoing radiotherapy breast cancer treatment.",
        "paragraphlabels": [
