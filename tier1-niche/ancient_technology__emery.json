    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 53,
        "endOffset": 80,
        "text": " in case you hadn't guessed",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "ajvkO0hn7v",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 263,
        "text": "As a scientist, I am, along with so many others, constantly thinking about where we'll be in five years, in 10 years, even in 50 years' time, the question which constantly drives our curiosity and our imagination to help solve global problems with simple answers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "n7_xVKw-Kb",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 89,
        "text": "Whether this be clean energy or health, there are major concerns facing our planet today.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "_DXgdXBPoU",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 49,
        "endOffset": 63,
        "text": "these problems",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "SDPJbC6ke5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
