    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 24,
        "text": "Can you see a connection",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "IEvhHm-m_9",
