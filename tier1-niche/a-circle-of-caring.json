{
  "project_id": 20,
  "project_label": "gemma",
  "task_id": 7793,
  "title": "A circle of caring",
  "author": "Jok Church",
  "url": "https://www.ted.com/talks/jok_church_a_circle_of_caring",
  "annotation_id": null,
  "completed_by": 7,
  "created_at": "2026-05-07T11:32:30.259485Z",
  "updated_at": "2026-05-07T11:32:30.259485Z",
  "lead_time": 26.601,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 8,
        "text": "You know",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3D98AEFDF5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 114,
        "text": "You know, what I do is write for children, and I'm probably America's most widely read children's author, in fact.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "769D80B9B7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 79,
        "text": "And I always tell people that I don't want to show up looking like a scientist.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8A268922BB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 78,
        "text": "You can have me as a farmer, or in leathers, and no one has ever chose farmer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "670E118CA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 18,
        "endOffset": 29,
        "text": "talk to you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D48961F0F2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 59,
        "text": "I'm here today to talk to you about circles and epiphanies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1DEA677631",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 4,
        "endOffset": 7,
        "text": "you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "ED00450B78",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 83,
        "text": "And you know, an epiphany is usually something you find that you dropped someplace.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4454BB1B79",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 64,
        "text": "You've just got to go around the block to see it as an epiphany.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "70D15D444A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 30,
        "text": "That's a painting of a circle.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E7CA10925E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 50,
        "text": "A friend of mine did that -- Richard Bollingbroke.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "00E749C50D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 69,
        "text": "It's the kind of complicated circle that I'm going to tell you about.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "424F5B7EA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 90,
        "text": "My circle began back in the '60s in high school in Stow, Ohio where I was the class queer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "30E5BD06C3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 93,
        "text": "I was the guy beaten up bloody every week in the boys' room, until one teacher saved my life.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BEF9536A77",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 75,
        "text": "She saved my life by letting me go to the bathroom in the teachers' lounge.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "372AD4D0D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 21,
        "text": "She did it in secret.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8BFFD8906D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 10,
        "text": "She did it",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "72D8DDA15D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 27,
        "text": "She did it for three years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3C13555568",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 29,
        "text": "And I had to get out of town.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "681604F003",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 172,
        "text": "I had a thumb, I had 85 dollars, and I ended up in San Francisco, California -- met a lover -- and back in the '80s, found it necessary to begin work on AIDS organizations.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DE79AE5800",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 100,
        "text": "About three or four years ago, I got a phone call in the middle of the night from that teacher, Mrs.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7B1FCCC137",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 19,
        "endOffset": 37,
        "text": "I need to see you.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7249C3E31F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 64,
        "text": "I'm disappointed that we never got to know each other as adults.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E552E58014",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 91,
        "text": "Could you please come to Ohio, and please bring that man that I know you have found by now.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "517C65A56D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 99,
        "text": "And I should mention that I have pancreatic cancer, and I'd like you to please be quick about this.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "12E3924A7F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 40,
        "text": "Well, the next day we were in Cleveland.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "032F480C65",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 23,
        "endOffset": 43,
        "text": "We laughed, we cried",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "931AE09700",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 92,
        "text": "We took a look at her, we laughed, we cried, and we knew that she needed to be in a hospice.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "427A32BAF0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 114,
        "text": "We found her one, we got her there, and we took care of her and watched over her family, because it was necessary.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C5F77D4C75",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 33,
        "text": "It's something we knew how to do.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FF2C0F8564",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 72,
        "endOffset": 102,
        "text": "she turned into a box of ashes",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "56782D0B3C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 130,
        "text": "And just as the woman who wanted to know me as an adult got to know me, she turned into a box of ashes and was placed in my hands.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B7A9AB4D5A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 49,
        "endOffset": 71,
        "text": "it had become a circle",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "F415BB78E5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 125,
        "text": "And what had happened was the circle had closed, it had become a circle -- and that epiphany I talked about presented itself.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "298E83B3E4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 45,
        "text": "The epiphany is that death is a part of life.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8B819A39CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 47,
        "text": "She saved my life; I and my partner saved hers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "08CA105273",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 12,
        "text": "And you know",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "88C0235CCC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 76,
        "text": "And you know, that part of life needs everything that the rest of life does.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5BC0C5BFE9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 9,
        "endOffset": 25,
        "text": "truth and beauty",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "B7A0E377E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 83,
        "text": "It needs truth and beauty, and I'm so happy it's been mentioned so much here today.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "651C5D303A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 96,
        "text": "it needs -- it needs dignity, love and pleasure",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E773D11F35",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 96,
        "text": "It also needs -- it needs dignity, love and pleasure, and it's our job to hand those things out.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8B6FB8B129",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 10,
        "text": "Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "751C950A9A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "03C7AA92D6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}