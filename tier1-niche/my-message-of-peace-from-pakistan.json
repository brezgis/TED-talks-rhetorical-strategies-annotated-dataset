    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 22,
        "text": "My name is Abdul Khan.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DED8A1BD28",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 21,
        "text": "I come from Peshawar.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B4875713D9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 35,
        "text": "I hope that you will be able to see",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "921E13AE38",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 143,
        "endOffset": 191,
        "text": "as rich and colorful as the satchels that I sell",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8E5F5E8275",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 44,
        "text": "My name is Meher and this is my friend Irim.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8AB72C0647",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 173,
        "text": "I hope to become a vet when I grow up so that I can take care of stray cats and dogs who wander around the streets of the village that I live near Gilgit, northern Pakistan.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D0BA471282",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 19,
        "text": "My name is Kailash.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C24CC908B4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
