    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 8,
        "endOffset": 77,
        "text": "would you like some of those orange bangles with the pink polka dots?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "40E5E79675",
      "from_name": "label",
      "to_name": "text",
