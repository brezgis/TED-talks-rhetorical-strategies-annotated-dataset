    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 47,
        "text": "We are but two threads cut from the same cloth.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "A78ECBD1D6",
      "from_name": "label",
      "to_name": "text",
