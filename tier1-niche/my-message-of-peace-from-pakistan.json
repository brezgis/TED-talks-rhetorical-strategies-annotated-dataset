    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 17,
        "text": "My name is Zamin.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "33B3CB36C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 58,
        "text": "And I'm an IDP, an internally displaced person, from Swat.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E1E1C391AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 46,
        "text": "Do you see me on the other side of this fence?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "17FCE54723",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 37,
        "text": "Do I matter, or really exist for you?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "582FC8004C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 16,
        "text": "My name is Iman.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9A7CB840F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 57,
        "text": "I am a fashion model, an up-and-coming model from Lahore.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "56C8CCAEDF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 40,
        "text": "Do you see me simply smothered in cloth?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "EE04BAC0D0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 11,
        "endOffset": 30,
        "text": "move beyond my veil",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3A9EBE6EC2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 35,
        "endOffset": 67,
        "text": "see me for who I truly am inside",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "178CA36B0C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 17,
        "text": "My name is Ahmed.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4A3660E25F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 46,
        "text": "I am an Afghan refugee from the Khyber agency.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A78FF2A461",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 28,
        "endOffset": 44,
        "text": "intense darkness",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "75C5ACE314",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 11,
        "endOffset": 37,
        "text": "Chris Anderson: Fantastic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "48206ECF28",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 18,
        "text": "Just stay up here.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B97E8144B0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 19,
        "text": "That was fantastic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "06721F32C3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I found that really moving.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2FD77BAA16",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 78,
        "text": "You know, we fought hard to get at least a small Pakistani contingent to come.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7DFAA6C089",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 37,
        "text": "It felt like it was really important.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DAAC50C1F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 36,
        "text": "They went through a lot to get here.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4EBC6E4D34",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 49,
        "text": "Would the Pakistanis please just stand up please?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E852E01647",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 40,
        "text": "I just really wanted to acknowledge you.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "A7FF63B75E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 11,
        "endOffset": 29,
        "text": "Thank you so much.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0A763AEC25",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 47,
        "text": "And that is why I want to illuminate the world.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "35C5B86B8E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 19,
        "text": "My name is Papusay.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "F295D9E089",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 30,
        "text": "My heart and drum beat as one.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "8770E4B0C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 84,
        "text": "If religion is the opium of the masses, then for me, music is my one and only ganja.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "99D7BF1A95",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 30,
        "text": "A rising tide lifts all boats.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "D6348527EC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 123,
        "text": "And the rising tide of India's spectacular economic growth has lifted over 400 million Indians into a buoyant middle class.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "50B4C3C8FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 141,
        "text": "But there are still over 650 million Indians, Pakistanis, Sri Lankans, Bangladeshis, Nepalese, who remain washed up on the shores of poverty.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "52B5C7CC20",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 152,
        "text": "Therefore as India and Pakistan, as you and I, it behooves us to transcend our differences, to celebrate our diversity, to leverage our common humanity.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "BBD2447A58",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 250,
        "text": "Our collective vision at Naya Jeevan, which for many of you, as you all recognize, means \"new life\" in Urdu and Hindi, is to rejuvenate the lives of millions of low income families by providing them with affordable access to catastrophic health care.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "1ECE9A2D8D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 71,
        "text": "Indeed it is the emerging world's first HMO for the urban working poor.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "029940B05A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 48,
        "text": "Why should we do this as Indians and Pakistanis?",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "222EDC1DBC",
      "from_name": "label",
      "to_name": "text",
