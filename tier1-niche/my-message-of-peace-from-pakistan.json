    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 92,
        "text": "And if our fates are intertwined, then we believe that it is good karma, it is good fortune.",
        "paragraphlabels": [
          "INCOMPLETE"
        ]
      },
      "id": "D853FD7E6A",
      "from_name": "label",
      "to_name": "text",
