    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Laughter)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DABF66DCE2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
