    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I was somebody when I came.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "FBFC280454",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I am somebody.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E9FA00E4A8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 39,
        "text": "I'll be a better somebody when I leave.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "C22260D0C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 39,
        "text": "I am somebody.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1C08029E85",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 31,
        "text": "I am powerful, and I am strong.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6DF54EF577",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 40,
        "text": "I deserve the education that I get here.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CD24541FF7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 57,
        "text": "I have things to do, people to impress, and places to go.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F6767033AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 22,
        "text": "And they said, \"Yeah!\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9969E018D6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 11,
        "endOffset": 65,
        "text": "You say it long enough, it starts to be a part of you.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "3854C011AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 11,
        "endOffset": 65,
        "text": "You say it long enough, it starts to be a part of you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E1300E6A02",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 39,
        "text": "(Applause) I gave a quiz, 20 questions.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B9E79386AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 20,
        "text": "A student missed 18.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E753271E99",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 32,
        "endOffset": 47,
        "text": "big smiley face",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D21FCF4A96",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 48,
        "text": "I put a \"+2\" on his paper and a big smiley face.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B24A7E1E6B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 24,
        "text": "(Laughter) He said, \"Ms.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D725E7C665",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 22,
        "text": "Pierson, is this an F?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "DB51DF67B1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 14,
        "text": "I said, \"Yes.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "043F2B10BE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 55,
        "text": "(Laughter) He said, \"Then why'd you put a smiley face?\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "229186B5C7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 24,
        "endOffset": 33,
        "text": "on a roll",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6998F29989",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 34,
        "text": "I said, \"Because you're on a roll.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4053E6CA56",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 18,
        "text": "You got two right.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8A789800D6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 25,
        "text": "You didn't miss them all.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "997AABD6D3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 45,
        "endOffset": 65,
        "text": "won't you do better?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0B5979258D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 11,
        "endOffset": 66,
        "text": "I said, \"And when we review this, won't you do better?\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8E379069B1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 0,
        "endOffset": 39,
        "text": "He said, \"Yes, ma'am, I can do better.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8A34EC03A7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 15,
        "endOffset": 44,
        "text": "sucks all the life out of you",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "697C4E313A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 45,
        "text": "You see, \"-18\" sucks all the life out of you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "57A7BBE3E7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 29,
        "text": "\"I ain't all bad\"",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2848211F37",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 1,
        "endOffset": 29,
        "text": "+2\" said, \"I ain't all bad.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0AED614D16",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 278,
        "text": "For years, I watched my mother take the time at recess to review, go on home visits in the afternoon, buy combs and brushes and peanut butter and crackers to put in her desk drawer for kids that needed to eat, and a washcloth and some soap for the kids who didn't smell so good.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BBF924A8BC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 39,
        "text": "See, it's hard to teach kids who stink.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A8343C16AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 33,
        "text": "(Laughter) And kids can be cruel.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D14C3431D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 155,
        "text": "And so she kept those things in her desk, and years later, after she retired, I watched some of those same kids come through and say to her, \"You know, Ms.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5CD3A5569B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 8,
        "endOffset": 41,
        "text": "You made a difference in my life.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E3EBE0D677",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 24,
        "text": "You made it work for me.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "F7E3FAC07E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 0,
        "endOffset": 75,
        "text": "You made me feel like I was somebody, when I knew, at the bottom, I wasn't.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "2E5AC60892",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "79",
        "end": "79",
        "startOffset": 0,
        "endOffset": 44,
        "text": "And I want you to just see what I've become.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "9D0998F6F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "80",
        "end": "80",
        "startOffset": 0,
        "endOffset": 223,
        "text": "And when my mama died two years ago at 92, there were so many former students at her funeral, it brought tears to my eyes, not because she was gone, but because she left a legacy of relationships that could never disappear.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4B49E8D33D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "81",
        "end": "81",
        "startOffset": 0,
        "endOffset": 40,
        "text": "Can we stand to have more relationships?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "D9DD0E017A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "82",
        "end": "82",
        "startOffset": 0,
        "endOffset": 11,
        "text": "Absolutely.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "61D33EAFB4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "83",
        "end": "83",
        "startOffset": 0,
        "endOffset": 32,
        "text": "Will you like all your children?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0BF6E5A58E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "84",
        "end": "84",
        "startOffset": 0,
        "endOffset": 14,
        "text": "Of course not.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A89DF695AC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "85",
        "end": "85",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Laughter)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F6A9C046BE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "86",
        "end": "86",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Laughter)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9EA5D1A980",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "87",
        "end": "87",
        "startOffset": 0,
        "endOffset": 65,
        "text": "You won't like them all, and the tough ones show up for a reason.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0D45CAF0E4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "88",
        "end": "88",
        "startOffset": 0,
        "endOffset": 20,
        "text": "It's the connection.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "627B072E2C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "89",
        "end": "89",
        "startOffset": 0,
        "endOffset": 23,
        "text": "It's the relationships.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "D3D1A01757",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "90",
        "end": "90",
        "startOffset": 156,
        "endOffset": 175,
        "text": "and we teach anyway",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "4A93257B00",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "90",
        "end": "90",
        "startOffset": 0,
        "endOffset": 176,
        "text": "So teachers become great actors and great actresses, and we come to work when we don't feel like it, and we're listening to policy that doesn't make sense, and we teach anyway.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "43D1BFABB3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "91",
        "end": "91",
        "startOffset": 0,
        "endOffset": 15,
        "text": "We teach anyway",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E5E5486885",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "91",
        "end": "91",
        "startOffset": 0,
        "endOffset": 43,
        "text": "We teach anyway, because that's what we do.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AE770A20A8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "92",
        "end": "92",
        "startOffset": 0,
        "endOffset": 39,
        "text": "Teaching and learning should bring joy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "212F46412F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "93",
        "end": "93",
        "startOffset": 0,
        "endOffset": 31,
        "text": "How powerful would our world be",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "74557DF5AA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "93",
        "end": "93",
        "startOffset": 47,
        "endOffset": 134,
        "text": "who were not afraid to take risks, who were not afraid to think, and who had a champion",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E0AD7E4BEE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
