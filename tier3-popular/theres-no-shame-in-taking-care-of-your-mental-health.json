  "lead_time": 53.066,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 14,
        "endOffset": 22,
        "text": "was hell",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6C257ECF90",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 57,
        "text": "(Laughter) It was my first time eating Nigerian \"jollof.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8561FF0CA1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 87,
        "text": "(Laughter) Actually, in all seriousness, I was going through a lot of personal turmoil.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA52E7C341",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 57,
        "text": "Faced with enormous stress, I suffered an anxiety attack.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B38B535536",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 33,
        "text": "On some days, I could do no work.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1217E803AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 54,
        "text": "On other days, I just wanted to lay in my bed and cry.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "31739700A4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 99,
        "text": "My doctor asked if I'd like to speak with a mental health professional about my stress and anxiety.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "59ABF2EF87",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 14,
        "text": "Mental health?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "402EE8C4F5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 52,
        "text": "I clammed up and violently shook my head in protest.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "37DDBCA843",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 27,
        "endOffset": 34,
        "text": "a shame",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B16E49BE30",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 7,
        "endOffset": 27,
        "text": "the weight of stigma",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8D3BDAEDE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 147,
        "text": "I have a loving, supportive family and incredibly loyal friends, yet I could not entertain the idea of speaking to anyone about my feeling of pain.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E0339219C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 7,
        "endOffset": 70,
        "text": "suffocated by the rigid architecture of our African masculinity",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A62EAD8909",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 1,
        "endOffset": 34,
        "text": "People have real problems, Sangu.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "E402EF7206",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 18,
        "text": "Get over yourself!",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "5E1134A0E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 138,
        "text": "The first time I heard \"mental health,\" I was a boarding school student fresh off the boat from Ghana, at the Peddie School in New Jersey.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8767A3CC16",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 91,
        "text": "I had just gone through the brutal experience of losing seven loved ones in the same month.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2022454EC6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 59,
        "endOffset": 77,
        "text": "God bless her soul",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "63E1F1CD0F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 81,
        "endOffset": 116,
        "text": "she inquired about my mental health",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E710236076",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 16,
        "text": "\"Is she mental?\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0AE1FCE4C7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 10,
        "text": "I thought.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2AC9FDBA40",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 37,
        "text": "Does she not know I'm an African man?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "6F16C2BA8F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 104,
        "text": "Like Okonkwo in \"Things Fall Apart\"",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A7A7253BCB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 48,
        "endOffset": 104,
        "text": "we African men neither process nor express our emotions.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C3102F74C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 26,
        "text": "We deal with our problems.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E36F0460C7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 11,
        "endOffset": 37,
        "text": "We deal with our problems.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "05543CFBDC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 143,
        "text": "I called my brother and laughed about \"Oyibo\" people -- white people -- and their strange diseases -- depression, ADD and those \"weird things.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "64F08F3533",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 54,
        "endOffset": 60,
        "text": "mental",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "0C0C1BE7ED",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 87,
        "endOffset": 166,
        "text": "madman with dirty, dread-locked hair, bumbling around half-naked on the streets",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F611990460",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 21,
        "text": "We all know this man.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "8F45D716DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 32,
        "text": "Our parents warned us about him.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6C8D96A839",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 30,
        "text": "\"Mommy, mommy, why is he mad?\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A93A1D6CB2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 7,
        "text": "\"Drugs!\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AEC1A884A2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 25,
        "text": "If you even look at drugs",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "28652B035F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 27,
        "endOffset": 46,
        "text": "you end up like him",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "494BB2BE87",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 11,
        "endOffset": 113,
        "text": "Come down with pneumonia, and your mother will rush you to the nearest hospital for medical treatment.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "585BABD52D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 62,
        "endOffset": 100,
        "text": "driving out demons and blaming witches",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D41B22B88F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 121,
        "endOffset": 195,
        "text": "to work productively and fruitfully; and to be able to make a contribution",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E7FDE703ED",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 196,
        "endOffset": 213,
        "text": "to your community",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CDA40C60D1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 74,
        "text": "Mental health includes our emotional, psychological and social well-being.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EEA49B1D9F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 86,
        "text": "Globally, 75 percent of all mental illness cases can be found in low-income countries.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4BCFB18448",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 103,
        "text": "Yet most African governments invest less than one percent of their health care budget in mental health.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D3153FDDBA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 65,
        "text": "Even worse, we have a severe shortage of psychiatrists in Africa.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3DBB4565F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 85,
        "text": "Nigeria, for example, is estimated to have 200 -- in a country of almost 200 million.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C41234A3AE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 68,
        "text": "In all of Africa, 90 percent of our people lack access to treatment.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0F937DB2CF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 16,
        "endOffset": 54,
        "text": "suffer in solitude, silenced by stigma",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2142A858B9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 94,
        "text": "We as Africans often respond to mental health with distance, ignorance, guilt, fear and anger.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B7A7386E34",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 41,
        "endOffset": 96,
        "text": "directly asking, \"What is the cause of mental illness?\"",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3C100E53B9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 106,
        "endOffset": 116,
        "text": "(Laughter)",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "7E047B6E79",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 70,
        "endOffset": 102,
        "text": "divine wrath and the will of God",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "63C466F644",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 129,
        "endOffset": 164,
        "text": "witchcraft and spiritual possession",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "7664004352",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 130,
        "text": "But few cited other known causes of mental illness, like genetics, socioeconomic status, war, conflict or the loss of a loved one.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "382826A8DE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 63,
        "endOffset": 89,
        "text": "ostracizing and demonizing",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "AB983ACA41",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 103,
        "text": "The stigmatization against mental illness often results in the ostracizing and demonizing of sufferers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A64F14D9A6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 113,
        "text": "Photojournalist Robin Hammond has documented some of these abuses ... in Uganda, in Somalia, and here in Nigeria.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "10BDE0E8B9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 31,
        "text": "For me, the stigma is personal.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DF815E2F7F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 62,
        "text": "In 2009, I received a frantic call in the middle of the night.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5DE6BAAC05",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 33,
        "endOffset": 72,
        "text": "brilliant, philosophical, charming, hip",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E0CA8C6F12",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 119,
        "text": "My best friend in the world -- a brilliant, philosophical, charming, hip young man -- was diagnosed with schizophrenia.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4BA4AD1772",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 58,
        "text": "I witnessed some of the friends we'd grown up with recoil.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "94478B2EA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 21,
        "text": "I heard the snickers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C6CB0E3928",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 21,
        "text": "I heard the whispers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9AE9C70BDA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 1,
        "endOffset": 30,
        "text": "Did you hear he has gone mad?",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "24C7DCC0F3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 15,
        "endOffset": 33,
        "text": "He has gone crazy!",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "8ADB34B0D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 131,
        "text": "eviscerates all empathy",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6638C1C971",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 131,
        "text": "Derogatory, demeaning commentary about his condition -- words we would never say about someone with cancer or someone with malaria.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0F632B1322",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 56,
        "endOffset": 79,
        "text": "eviscerates all empathy",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BAEE661B4F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 80,
        "text": "Somehow, when it comes to mental illness, our ignorance eviscerates all empathy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E56F45D390",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 78,
        "text": "I stood by his side as his community isolated him, but our love never wavered.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C923832AD6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 49,
        "text": "Tacitly, I became passionate about mental health.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F7460290B4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 101,
        "text": "Inspired by his plight, I helped found the mental health special interest alumni group at my college.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7A7B185750",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 129,
        "text": "And during my tenure as a resident tutor in graduate school, I supported many undergraduates with their mental health challenges.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8523BDB6AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 62,
        "text": "I saw African students struggle and unable to speak to anyone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "461B48FCAF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 138,
        "endOffset": 177,
        "text": "so deep is our fear of being the madman",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "C30D2F5E44",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 137,
        "text": "Even with this knowledge and with their stories in tow, I, in turn, struggled, and could not speak to anyone when I faced my own anxiety,",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "02447CBED0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 39,
        "text": "All of us -- but we Africans especially",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "3384FC52E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 43,
        "endOffset": 158,
        "text": "need to realize that our mental struggles do not detract from our virility, nor does our trauma taint our strength.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "61A4AACEC0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 61,
        "text": "We need to see mental health as important as physical health.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0CC09DC65F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 37,
        "text": "We need to stop suffering in silence.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "989937A69E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 65,
        "text": "We must stop stigmatizing disease and traumatizing the afflicted.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5E14BFE099",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Talk to your friends.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "B21ACE50E8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 24,
        "text": "Talk to your loved ones.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "4229556E23",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Talk to health professionals.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7C1F662F41",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 14,
        "text": "Be vulnerable.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CD0248F300",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 49,
        "text": "Do so with the confidence that you are not alone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5062D8F7CC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 30,
        "text": "Speak up if you're struggling.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "446764F45A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 72,
        "text": "Being honest about how we feel does not make us weak; it makes us human.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "09C3053FBE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 60,
        "text": "It is time to end the stigma associated with mental illness.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2BA4438895",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 62,
        "endOffset": 68,
        "text": "madman",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BF8AAAAE29",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 17,
        "endOffset": 26,
        "text": "your hear",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7270EAAEB2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 12,
        "text": "Think of me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1DD29240D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 21,
        "text": "(Applause) Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1628F91046",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DBFC95EF61",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}