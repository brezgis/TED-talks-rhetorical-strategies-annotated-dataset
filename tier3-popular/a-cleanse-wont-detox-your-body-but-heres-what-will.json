      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 45,
        "text": "So talk to your doctor before you start them.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7C3F73F9C8",
