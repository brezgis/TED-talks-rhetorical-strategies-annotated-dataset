    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 26,
        "endOffset": 50,
        "text": "sleep our way to the top",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "4783B4EA32",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 7,
        "endOffset": 16,
        "text": "literally",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "5B5746F50C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 89,
        "endOffset": 168,
        "text": "because unfortunately, for men, sleep deprivation has become a virility symbol.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "12AEEDA08A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 110,
        "text": "I was recently having dinner with a guy who bragged that he had only gotten four hours sleep the night before.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E255230D55",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 74,
        "endOffset": 88,
        "text": "You know what?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "DB9C6C9EC7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
