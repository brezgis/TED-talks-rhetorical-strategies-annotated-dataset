    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 39,
        "text": "This is a room of sleep-deprived women.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CAFD3B4D13",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 46,
        "text": "And I learned the hard way the value of sleep.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3CF5E6EBAF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 52,
        "text": "Two-and-a-half years ago, I fainted from exhaustion.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2570983E58",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 25,
        "text": "I hit my head on my desk.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5106BB8619",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 58,
        "text": "I broke my cheekbone, I got five stitches on my right eye.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA725DD043",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 60,
        "text": "And I began the journey of rediscovering the value of sleep.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "81D9BBA233",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 27,
        "endOffset": 43,
        "text": "I studied, I met",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "9C1D3ADB35",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 82,
        "endOffset": 102,
        "text": "I'm here to tell you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "6F7C2F10F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 98,
        "text": "(Applause) And we women are going to lead the way in this new revolution, this new feminist issue.",
