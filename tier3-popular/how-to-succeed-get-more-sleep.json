    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 89,
        "endOffset": 111,
        "text": "if you had gotten five",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "F5B143F8FB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 66,
        "text": "(Laughter) There is now a kind of sleep deprivation one-upmanship.",
