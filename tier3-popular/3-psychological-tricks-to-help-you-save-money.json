    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 85,
        "text": "What we're doing in that second group is highlighting that a transition is happening.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6DA2E1BB60",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 107,
        "text": "All of a sudden, we saw click-through rates, and ultimately sign-up rates, increase when we highlight that.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EE35B3910C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
