      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 83,
        "text": "And these are made of this kind of tube -- electricity tube, we call it in Holland.",
