    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 76,
        "text": "I would like to tell you about a project which I started about 16 years ago.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "31CC092FCA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 36,
        "text": "It's about making new forms of life.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D272599418",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
