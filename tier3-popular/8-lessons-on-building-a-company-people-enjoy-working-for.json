        "end": "0",
        "startOffset": 0,
        "endOffset": 25,
        "text": "HR jargon makes me crazy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F503DEF1BA",
      "from_name": "label",
      "to_name": "text",
