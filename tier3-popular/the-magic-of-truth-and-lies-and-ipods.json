  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 15,
        "endOffset": 20,
        "text": "magic",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "213BDC08BA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 99,
        "text": "So the type of magic I like, and I'm a magician, is magic that uses technology to create illusions.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E94B9C849F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 19,
        "endOffset": 27,
        "text": "show you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CC0F64DFCD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 59,
        "text": "So I would like to show you something I've been working on.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B7BD039036",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 96,
        "text": "It's an application that I think will be useful for artists -- multimedia artists in particular.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "754D68006F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 65,
        "text": "It synchronizes videos across multiple screens of mobile devices.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6990D0C853",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 65,
        "endOffset": 73,
        "text": "show you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "94BE6941E0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 86,
        "text": "I borrowed these three iPods from people here in the audience to show you what I mean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C698642D23",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 29,
        "endOffset": 37,
        "text": "tell you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "B9D6C535AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 88,
        "text": "And I'm going to use them to tell you a little bit about my favorite subject: deception.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9742CFFBA1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 53,
        "text": "(Music) One of my favorite magicians is Karl Germain.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ECE6C57A22",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 36,
        "endOffset": 56,
        "text": "rosebush would bloom",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D343DDD75B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 85,
        "text": "He had this wonderful trick where a rosebush would bloom right in front of your eyes.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1B3005771D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 69,
        "text": "But it was his production of a butterfly that was the most beautiful.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D8CE23ADD9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 66,
        "text": "(Recording) Announcer: Ladies and gentlemen, the creation of life.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E26D5A4CF8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 123,
        "text": "(Applause) (Music) Marco Tempest: When asked about deception, he said this: Announcer: Magic is the only honest profession.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "963DE84BC2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 50,
        "text": "A magician promises to deceive you -- and he does.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A0DE28781D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 52,
        "text": "MT: I like to think of myself as an honest magician.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D02E7ED391",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 71,
        "text": "I use a lot of tricks, which means that sometimes I have to lie to you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "409541D18F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 26,
        "text": "Now I feel bad about that.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9401DC5489",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 25,
        "text": "But people lie every day.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "38CFA6B2FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 10,
        "endOffset": 18,
        "text": "Hold on.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "03049669B7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 7,
        "endOffset": 26,
        "text": "Hey, where are you?",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BDD06F3F33",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 4,
        "endOffset": 21,
        "text": "Stuck in traffic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B90E66A83D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 19,
        "text": "I'll be there soon.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6C10E5D4EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 19,
        "text": "You've all done it.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "B0820892D0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 66,
        "text": "(Laughter) (Music) Right: I'll be ready in just a minute, darling.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3F386CC1CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 8,
        "endOffset": 42,
        "text": "It's just what I've always wanted.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA0B3EE7C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 6,
        "endOffset": 21,
        "text": "You were great.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B6D856FBEA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 4,
        "endOffset": 47,
        "text": "Deception, it's a fundamental part of life.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "9C84FAD7EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 105,
        "text": "Now polls show that men tell twice as many lies as women -- assuming the women they asked told the truth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7EB5E8E366",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 11,
        "endOffset": 67,
        "text": "We deceive to gain advantage and to hide our weaknesses.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "53F8CCDED9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 69,
        "text": "The Chinese general Sun Tzu said that all war was based on deception.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B2FDB25028",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 43,
        "text": "Oscar Wilde said the same thing of romance.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1D40314380",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 30,
        "text": "Some people deceive for money.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9C0CF09928",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 18,
        "text": "Let's play a game.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CDD2F6BBE1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 27,
        "text": "Three cards, three chances.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D686B6CE45",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 56,
        "text": "Announcer: One five will get you 10, 10 will get you 20.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0A9AD0CB3A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 22,
        "text": "Now, where's the lady?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "67DB8F9639",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 19,
        "text": "Where is the queen?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D8174E275F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 13,
        "text": "MT: This one?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "877BDF9A5C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 6,
        "text": "Sorry.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B16E8A74B7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 9,
        "text": "You lose.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "519E7DB3FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 27,
        "text": "Well, I didn't deceive you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3234A75BFB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 22,
        "text": "You deceived yourself.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "230C11E492",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 15,
        "text": "Self-deception.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "13085D7EC4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 58,
        "text": "That's when we convince ourselves that a lie is the truth.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B85D079C71",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 42,
        "text": "Sometimes it's hard to tell the two apart.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CAFBB8B836",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 50,
        "text": "Compulsive gamblers are experts at self-deception.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CAE12F56EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 15,
        "endOffset": 41,
        "text": "They believe they can win.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FD0F1E04F0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 32,
        "text": "They forget the times they lose.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "02F0E1787C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 37,
        "text": "The brain is very good at forgetting.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1DB52DA2F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 38,
        "text": "Bad experiences are quickly forgotten.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FEC60D26BB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 34,
        "text": "Bad experiences quickly disappear.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7A8C4F0994",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 78,
        "text": "Which is why in this vast and lonely cosmos, we are so wonderfully optimistic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C5865884F4",
