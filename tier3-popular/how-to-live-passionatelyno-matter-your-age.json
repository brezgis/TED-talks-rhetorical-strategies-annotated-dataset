  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 9,
        "text": "Hi, kids.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B2B42FF646",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 18,
        "text": "(Laughter) I'm 71.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9AEAF3F8CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 28,
        "text": "(Applause) My husband is 76.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C4C3A92F24",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 61,
        "text": "My parents are in their late 90s, and Olivia, the dog, is 16.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4020D35284",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 26,
        "text": "So let's talk about aging.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F39314AF4C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 105,
        "endOffset": 145,
        "text": "dropped and I can't find them down there",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B923009FCC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 50,
        "endOffset": 89,
        "text": "Tell me, what is it that you plan to do",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0E10A10C73",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 34,
        "text": "Me, I intend to live passionately.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "992891788B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 23,
        "text": "When do we start aging?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "8E3A024F55",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 109,
        "text": "Society decides when we are old, usually around 65, when we get Medicare, but we really start aging at birth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DE632D6804",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 61,
        "text": "We are aging right now, and we all experience it differently.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4AEC1499B1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 69,
        "text": "We all feel younger than our real age, because the spirit never ages.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8B83AC87E4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 14,
        "text": "I am still 17.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B52FB10835",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 13,
        "text": "Sophia Loren.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8A20F46937",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 12,
        "text": "Look at her.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "17FCD7AF1D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 45,
        "endOffset": 54,
        "text": "spaghetti",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BA708B3C6D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 25,
        "endOffset": 28,
        "text": "you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "F916ADBC16",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 52,
        "text": "I tried it and gained 10 pounds in the wrong places.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8E6601F090",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 4,
        "endOffset": 47,
        "text": "attitude, aging is also attitude and health",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "F8106D93CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 59,
        "text": "But my real mentor in this journey of aging is Olga Murray.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F7E337DA04",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 94,
        "text": "This California girl at 60 started working in Nepal to save young girls from domestic bondage.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6FAC14A721",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 82,
        "text": "At 88, she has saved 12,000 girls, and she has changed the culture in the country.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "09D5EDA0F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 80,
        "text": "(Applause) Now it is illegal for fathers to sell their daughters into servitude.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "03F72AF951",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 56,
        "text": "She has also founded orphanages and nutritional clinics.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D382DAD742",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 24,
        "endOffset": 39,
        "text": "eternally young",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "561AE45064",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 37,
        "text": "What have I lost in the last decades?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7D3914910C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 124,
        "text": "People, of course, places, and the boundless energy of my youth, and I'm beginning to lose independence, and that scares me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "37AF146136",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 83,
        "text": "Ram Dass says that dependency hurts, but if you accept it, there is less suffering.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7FFE1823B2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 29,
        "endOffset": 41,
        "text": "ageless soul",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A1E524F660",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 137,
        "text": "After a very bad stroke, his ageless soul watches the changes in the body with tenderness, and he is grateful to the people who help him.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F339AA5E43",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 19,
        "text": "What have I gained?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "54BDF6FDEB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 48,
        "text": "Freedom: I don't have to prove anything anymore.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E9458B54F3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 29,
        "endOffset": 94,
        "text": "who I was, who I want to be, or what other people expect me to be",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "0EF3E75A0E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 95,
        "text": "I'm not stuck in the idea of who I was, who I want to be, or what other people expect me to be.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A27E12EAEC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 36,
        "endOffset": 48,
        "text": "only animals",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "0000DCA403",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 49,
        "text": "I don't have to please men anymore, only animals.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CA87BEEA0E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 18,
        "endOffset": 26,
        "text": "superego",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "68EDA41208",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 74,
        "text": "I keep telling my superego to back off and let me enjoy what I still have.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3CCFD8288A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 15,
        "endOffset": 28,
        "text": "falling apart",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A25975FEAB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 55,
        "text": "My body may be falling apart, but my brain is not, yet.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "46141D0C5D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 16,
        "text": "I love my brain.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "199A56E32E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 15,
        "text": "I feel lighter.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ED042A5A46",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 14,
        "endOffset": 64,
        "text": "grudges, ambition, vanity, none of the deadly sins",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "7A5ED44653",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 101,
        "text": "I don't carry grudges, ambition, vanity, none of the deadly sins that are not even worth the trouble.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8640D14F7B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 21,
        "text": "It's great to let go.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "235F422444",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 29,
        "text": "I should have started sooner.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DFEF751AF9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 66,
        "text": "And I also feel softer because I'm not scared of being vulnerable.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FFE00197B6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 35,
        "text": "I don't see it as weakness anymore.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F350B35A09",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 29,
        "text": "And I've gained spirituality.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "934340B204",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 23,
        "endOffset": 52,
        "text": "death was in the neighborhood",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A31EC08536",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 53,
        "text": "I'm aware that before, death was in the neighborhood.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A1D0F76D3E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 36,
        "text": "death was next door, or in my house",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6336670F2D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 36,
        "text": "Now, it's next door, or in my house.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "23D20DE671",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 53,
        "text": "I try to live mindfully and be present in the moment.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F69A2B7377",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 46,
        "endOffset": 62,
        "text": "aged beautifully",
        "paragraphlabels": [
