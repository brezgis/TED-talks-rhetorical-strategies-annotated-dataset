      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "84",
        "end": "84",
        "startOffset": 0,
        "endOffset": 41,
        "text": "Now it's our time, and it's a great time.",
