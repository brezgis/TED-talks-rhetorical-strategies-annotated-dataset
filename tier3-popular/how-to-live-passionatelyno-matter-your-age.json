      },
      "id": "C585710B65",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 8,
        "text": "You know",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "2BD98EB933",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 79,
        "text": "You know, for a vain female like myself, it's very hard to age in this culture.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B40536E181",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 28,
        "endOffset": 53,
        "text": "charming, seductive, sexy",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3F0431670E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 54,
        "text": "Inside, I feel good, I feel charming, seductive, sexy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "78F3F94DAD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 22,
        "text": "Nobody else sees that.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "132D6EF5CB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 25,
        "text": "(Laughter) I'm invisible.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4D8E33B8FA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 37,
        "text": "I want to be the center of attention.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F087CCA865",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 23,
        "text": "I hate to be invisible.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5D5C113627",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 22,
        "endOffset": 44,
        "text": "This is Grace Dammann.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E94568B2E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 73,
        "text": "She has been in a wheelchair for six years after a terrible car accident.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "186D7FF7A5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 68,
        "endOffset": 115,
        "text": "every drop of water is a blessing to the senses",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D80BBDB07A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 36,
        "text": "She doesn't see herself as disabled.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EC77D487EA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 13,
        "endOffset": 45,
        "text": "she's still surfing in the ocean",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "924AE115CC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 84,
        "text": "Ethel Seiderman, a feisty, beloved activist in the place where I live in California.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EBAFBAF9FD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 87,
        "text": "She wears red patent shoes, and her mantra is that one scarf is nice but two is better.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A2D2E613D7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 76,
        "text": "She has been a widow for nine years, but she's not looking for another mate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9CE090D4F5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 14,
        "endOffset": 66,
        "text": "there is only a limited number of ways you can screw",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "526B04FE24",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 131,
        "text": "She says that there is only a limited number of ways you can screw — well, she says it in another way — and she has tried them all.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8ECD8332EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 11,
        "endOffset": 142,
        "text": "I, on the other hand, I still have erotic fantasies with Antonio Banderas — (Laughter) — and my poor husband has to put up with it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F1B8383B18",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 29,
        "text": "So how can I stay passionate?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "23F0E88C2C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 44,
        "text": "I cannot will myself to be passionate at 71.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DE5EF57E0E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 78,
        "text": "I have been training for some time, and when I feel flat and bored, I fake it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "952F48B690",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 19,
        "text": "Attitude, attitude.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "6678EBC7AE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 15,
        "text": "How do I train?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "389DC80EBD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
