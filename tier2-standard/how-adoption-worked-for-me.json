      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 15,
        "text": "I did the same.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "94AEBE51D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 76,
        "text": "Mind you, I drove about seven hours from my village to the airport that day.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0EE2B63915",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
