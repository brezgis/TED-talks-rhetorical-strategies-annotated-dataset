        "endOffset": 117,
        "text": "literally had to teach me everything from scratch",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BD894C9873",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
