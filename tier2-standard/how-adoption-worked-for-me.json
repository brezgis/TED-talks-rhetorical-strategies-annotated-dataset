        "text": "this is a microwave, that's a refrigerator",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "80003E156D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 79,
        "text": "And it was also the first time I got immersed into a new and different culture.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5D5998AC53",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 36,
        "text": "These strangers showed me true love.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "757837BB36",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 67,
        "text": "These strangers showed me that I mattered, that my dreams mattered.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B1002099F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
