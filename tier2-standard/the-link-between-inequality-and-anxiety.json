{
  "project_id": 21,
  "project_label": "gemma",
  "task_id": 8830,
  "title": "The link between inequality and anxiety",
  "author": "Richard Wilkinson",
  "url": "https://www.ted.com/talks/richard_wilkinson_the_link_between_inequality_and_anxiety",
  "annotation_id": null,
  "completed_by": 7,
  "created_at": "2026-05-07T11:36:40.609467Z",
  "updated_at": "2026-05-07T11:36:40.609467Z",
  "lead_time": 52.804,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 23,
        "text": "I'm sure you've noticed",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "6EB64ACB12",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 124,
        "text": "I'm sure you've noticed the difference between posed photographs and pictures taken of people who are unaware of the camera.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3A35D99616",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 41,
        "endOffset": 66,
        "text": "they often look like this",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "9A5AF32B7B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 67,
        "text": "The pictures where people are unaware -- they often look like this.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "02326C3C3E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 41,
        "text": "This picture was taken in central London.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1509DEB031",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 58,
        "endOffset": 85,
        "text": "haggard, depressed, anxious",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "8D7DD18BEB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 86,
        "text": "People in the prime of life, and yet everyone there looks haggard, depressed, anxious.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3207607F2E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 30,
        "text": "Some of them look quite angry.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6776AA74F3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 23,
        "text": "Not a smile to be seen.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0DE457D050",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 9,
        "endOffset": 20,
        "text": "if you look",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "53D0EE5726",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 108,
        "text": "And yet, if you look at pictures of people posed, they put their arms around each other, as in this picture.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D2022FEFF2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 11,
        "text": "They smile.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F71A4E91CF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 78,
        "text": "That's, I think, how we'd like to be seen, how we think we should be together.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7DEFB756AC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 48,
        "text": "Unfortunately, the data tells a different story.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6AA92AED03",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 189,
        "text": "In the UK, surveys have shown that 74 percent of adults have felt so stressed or overwhelmed and unable to cope, 32 percent have had suicidal thoughts, 16 percent have actually self-harmed.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2343E08052",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 128,
        "text": "In the USA, the picture's very similar: 79 percent felt stressed every day, and almost 60 percent have felt paralyzed by stress.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E0DE5BA337",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 133,
        "endOffset": 153,
        "text": "what's the response?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "F6B4F27C36",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 153,
        "text": "When there are new figures that come out in the media showing levels of stress, depression, self-harm, drug abuse, eating disorders, what's the response?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D3E73F89B5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 99,
        "text": "It's simply to demand more services, more psychotherapists, more psychologists, more psychiatrists.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "56A28FD3E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 57,
        "endOffset": 74,
        "text": "seriously injured",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6EB995B5CF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 154,
        "endOffset": 168,
        "text": "stitch them up",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "CE1AD5FFB6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 169,
        "text": "It's as if a large majority of the population were being seriously injured and instead of finding out what’s going wrong, we simply want more surgeons to stitch them up.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "419EAE0A76",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 59,
        "text": "The crucial question we must ask is: Why is this happening?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3E6F3D3068",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 27,
        "text": "Why even in rich countries?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "22D584E201",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 122,
        "text": "I'm an epidemiologist, which means I've spent my career doing research on the causes of health and illness in populations.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CCC3DA4B9A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 28,
        "endOffset": 65,
        "text": "inequality is a really powerful cause",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "0F01CE43A2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 86,
        "endOffset": 138,
        "text": "anxiety and mental distress, unhappiness, depression",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "093537B901",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 36,
        "text": "I'd like you to cast your minds back",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "57B9D2108A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 16,
        "endOffset": 36,
        "text": "cast your minds back",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D851CAC405",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 108,
        "text": "But all sorts of situations where we face the threat of being seen negatively cause these sorts of emotions.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "68080AD04E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 197,
        "text": "This graph is a summary of hundreds of studies of exposing people to different kinds of stress while measuring what happens to their stress hormones, principally cortisol, a central stress hormone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2670EE1489",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 96,
        "endOffset": 120,
        "text": "social evaluative threat",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "DD839610E7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 125,
        "endOffset": 164,
        "text": "threats to self-esteem or social status",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "09918B41AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 155,
        "text": "So although these social stresses are widely recognized and we're all familiar with them, people fail to see how inequality makes them worse for all of us.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EA11626E00",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 150,
        "text": "In this slide, along the bottom, you've got different income groups, from the poorest tenth of the population on the left to the richest on the right.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F85B1D13DE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 124,
        "text": "And up the side, you've got a measure of status anxiety, how worried people are about how they're seen and judged by others.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "932B41A500",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 99,
        "text": "The top line shows levels of status anxiety across all income groups in the more unequal societies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FF7CEB4C47",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 94,
        "text": "And the bottom line shows the much lower levels of status anxiety in the more equal societies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B2470F6B57",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 144,
        "text": "I think what we're dealing with is whether we live in societies with a very steep social hierarchy like that, or a much shallower one like that.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4EC90881AA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 13,
        "endOffset": 40,
        "text": "bigger material differences",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1F68FB6204",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 65,
        "endOffset": 81,
        "text": "social distances",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1C11F0A78C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 92,
        "endOffset": 131,
        "text": "feelings of superiority and inferiority",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "44B68B1A93",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 11,
        "text": "If you like",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "995DC01611",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 39,
        "text": "Status and class become more important.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "622CC52167",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 68,
        "text": "We're less likely to marry people with a different class background.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1F8EC7A5C0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 40,
        "text": "Community life, as I've said, drops away",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "95C3CA8F18",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 42,
        "endOffset": 67,
        "text": "and violence also goes up",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "A859F09546",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 77,
        "endOffset": 131,
        "text": "violence is triggered by people feeling looked down on",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3859CCCB7B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 77,
        "text": "Loss of face, disrespected, humiliated -- those are the triggers of violence.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "757294BAD5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 100,
        "text": "And of course, for people who are more sensitive to status issues, violence is triggered more often.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D11BEDA4A9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 84,
        "text": "Consumerism also goes up, because we're all trying to enhance our self-presentation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1136C0B727",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 90,
        "endOffset": 114,
        "text": "ossified with inequality",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E9B21BFFFA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 147,
        "text": "Social mobility goes down, and with that, we're even further away from the equal opportunities which we claim to be trying to provide for children.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "176180322C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 53,
        "text": "So inequality isn't just about unfairness or poverty.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "04A6D75D7C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 81,
        "text": "It puts us in social relationships, relationships of superiority and inferiority.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "26BAD9DB45",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 33,
        "text": "It ranks us from better to worse.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "219611DBB2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 31,
        "text": "It's a really invidious process",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "0005FFBBC3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 33,
        "endOffset": 92,
        "text": "and it creates those feelings of inferiority at the bottom.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6BC03C7D93",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 133,
        "text": "It makes us judge each other more by social status, and with that, we become more worried about how we are seen and judged by others.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "74591A035B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 85,
        "text": "There are two common responses to feeling so worried about how we're seen and judged.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F973C4007C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 84,
        "text": "One is that you almost accept your inferiority, low self-esteem, lack of confidence.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BA9954361E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 12,
        "text": "You withdraw",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "298D6FC981",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 38,
        "endOffset": 46,
        "text": "you find",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "41AB7A5741",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 73,
        "endOffset": 83,
        "text": "you become",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "106B14FFE9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 69,
        "text": "And indeed, rates of depression are higher in more unequal societies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1B9BD72038",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 57,
        "text": "The other common response is almost exactly the opposite.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1AF4052D40",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 3,
        "endOffset": 17,
        "text": "you're worried",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "C1C309AA29",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 50,
        "endOffset": 58,
        "text": "you talk",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0A8B120C7D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 20,
        "text": "You big yourself up.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "F0A315A5F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 43,
        "text": "You flaunt your abilities and achievements.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "81CA2CF4FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 42,
        "text": "You become narcissistic instead of modest.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DCD9EFD7CE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 44,
        "text": "We see that, too, in more unequal societies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8229F0B54C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 76,
        "text": "This next graph is from a study of what psychologists call self-enhancement.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EB17FA6407",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 112,
        "text": "People in different countries are asked how they think they compare to the average on different characteristics.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D8BA9F6A68",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 49,
        "endOffset": 73,
        "text": "people big themselves up",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "79DC80784C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 142,
        "endOffset": 157,
        "text": "exaggerated way",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "078B4BB284",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 25,
        "text": "They become narcissistic.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8436662D5B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 64,
        "text": "It's like everyone thinking they're better drivers than average.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6F865EBD72",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 51,
        "text": "That tendency is greater in more unequal societies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FCA28DCA43",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 191,
        "text": "Mental illness is also worse in more unequal countries, because mental illness is often triggered or exacerbated by issues to do with dominance and subordination, superiority and inferiority.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "21311F0444",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 60,
        "endOffset": 77,
        "text": "tight correlation",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "89D45656DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 166,
        "text": "There was a recent study of the 36 OECD countries showing a tight correlation between levels of inequality in those societies and the 10 most common mental disorders.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4EF3D2FC52",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 235,
        "text": "I think the saddest part of this is that studies of happiness and well-being, studies of health, too, show that one of the most important determinants is the quality of our social relationships, our social environment, our friendships.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DC51B1E85C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 54,
        "text": "And that is where inequality does its greatest damage.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A5ED4AB476",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 16,
        "endOffset": 28,
        "text": "heavy burden",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "E242472AB7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 176,
        "text": "To address this heavy burden of depression, anxiety, mental illness, self-harm, what we have to do is reduce the levels of inequality in society that divide us from each other.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F19ADE16F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 27,
        "endOffset": 36,
        "text": "the enemy",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B5285FE999",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 48,
        "text": "Inequality is, in a sense, the enemy between us.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BD4A60038C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}