  "title": "The fingerprints of life beyond Earth",
  "author": "Clara Sousa-Silva",
  "url": "https://www.ted.com/talks/clara_sousa_silva_the_fingerprints_of_life_beyond_earth",
  "annotation_id": null,
  "completed_by": 7,
