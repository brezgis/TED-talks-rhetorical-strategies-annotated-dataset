    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 16,
        "endOffset": 25,
        "text": "grave day",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "665B982F19",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
