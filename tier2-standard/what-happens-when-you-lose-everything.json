    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 10,
        "text": "My archive",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "EE0829F5D1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 12,
        "endOffset": 95,
        "text": "175 films, my 16-millimeter negative, all my books, my dad's books, my photographs.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6E1E1690E0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 52,
        "text": "I'd collected -- I was a collector, major, big-time.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5C719C1F3D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 10,
        "text": "It's gone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "12A6BA4B68",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 50,
        "text": "I just looked at it, and I didn't know what to do.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DC0FB61E78",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 20,
        "endOffset": 36,
        "text": "was I my things?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "31562A2D0C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 51,
        "text": "I always live in the present -- I love the present.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "3D2C440BA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 21,
        "text": "I cherish the future.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C9EB422150",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 107,
        "text": "And I was taught some strange thing as a kid, like, you've got to make something good out of something bad.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "038F472BDF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 55,
        "text": "You've got to make something good out of something bad.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "BB8A9F36A7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 13,
        "text": "This was bad!",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0EC4837910",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 22,
        "text": "Man, I was -- I cough.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5B2922C925",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 11,
        "text": "I was sick.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B9B5C7DD7D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 22,
        "text": "That's my camera lens.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "30D282FDCB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 68,
        "text": "The first one -- the one I shot my Bob Dylan film with 35 years ago.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D310CAC916",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 23,
        "text": "That's my feature film.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ED293872F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 69,
        "text": "\"King, Murray\" won Cannes Film Festival 1970 -- the only print I had.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1039587E67",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 17,
        "text": "That's my papers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5DD22B7835",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 34,
        "text": "That was in minutes -- 20 minutes.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1D48D84E15",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 16,
        "text": "Epiphany hit me.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D0244FFEDC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 17,
        "text": "Something hit me.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "EB637E2FA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 111,
        "text": "\"You've got to make something good out of something bad,\" I started to say to my friends, neighbors, my sister.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "98E76D7595",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 29,
        "text": "By the way, that's \"Sputnik.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FB1B525085",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 19,
        "text": "I ran it last year.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9D4ECA992C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 37,
        "text": "\"Sputnik\" was downtown, the negative.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "27FAC94842",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 18,
        "text": "It wasn't touched.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "40FEB75385",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 113,
        "text": "These are some pieces of things I used in my Sputnik feature film, which opens in New York in two weeks downtown.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2660A13FA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 19,
        "text": "I called my sister.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DAB25E5DE7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 22,
        "text": "I called my neighbors.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "27A0E305E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 19,
        "text": "I said, \"Come dig.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "57B9F86F36",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 21,
        "text": "That's me at my desk.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "367B7FEFF5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 44,
        "text": "That was a desk took 40-some years to build.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "81FDA1D5F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 26,
        "text": "You know -- all the stuff.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "124AC4858C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 25,
        "text": "That's my daughter, Jean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "446131D824",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 9,
        "text": "She came.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F7D659C2D9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 31,
        "text": "She's a nurse in San Francisco.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B00AD371C1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 20,
        "text": "\"Dig it up,\" I said.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2776C3616A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 8,
        "text": "\"Pieces.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5EE7410CB3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 14,
        "text": "I want pieces.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CD6088CC2C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 17,
        "text": "\"Bits and pieces.\"",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "4C3C6D8EF5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 26,
        "endOffset": 51,
        "text": "a life of bits and pieces",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B67F54F988",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 17,
        "text": "That's my sister.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DC7D1F8F03",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 108,
        "text": "She took care of pictures, because I was a big collector of snapshot photography that I believed said a lot.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3D6E1F8775",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 43,
        "endOffset": 87,
        "text": "something was good about the burnt pictures.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F58945CCA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 14,
        "text": "I didn't know.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D65FF8B64A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 100,
        "text": "I looked at that -- I said, \"Wow, is that better than the --\" That's my proposal on Jimmy Doolittle.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "124A0885DF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 33,
        "text": "I made that movie for television.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F1399D3DBF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 25,
        "text": "It's the only copy I had.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B64C4C7C6B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 13,
        "text": "Pieces of it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "828D427060",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 17,
        "text": "Idea about women.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "49CC089383",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 49,
        "text": "So I started to say, \"Hey, man, you are too much!\"",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "682CC54652",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 25,
        "text": "You could cry about this.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "61374CD5D9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 16,
        "text": "I really didn't.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DDB9518255",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 84,
        "text": "I just instead said, \"I'm going to make something out of it, and maybe next year ...\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6F21A31E9B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 2,
        "endOffset": 158,
        "text": "And I appreciate this moment to come up on this stage with so many people who've already given me so much solace, and just say to TEDsters: I'm proud of me.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "74327A7E62",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 105,
        "text": "That I take something bad, I turn it, and I'm going to make something good out of this, all these pieces.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "992298EB7E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 52,
        "text": "That's Arthur Leipzig's original photograph I loved.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "62456EC367",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 59,
        "text": "I was a big record collector -- the records didn't make it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "67D1136FA9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 28,
        "text": "Boy, I tell you, film burns.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "3C5DB58FCC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 11,
        "text": "Film burns.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "680429BC5E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 43,
        "text": "I mean, this was 16-millimeter safety film.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "779AABF242",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 23,
        "text": "The negatives are gone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B92BC9A99A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 93,
        "text": "That's my father's letter to me, telling me to marry the woman I first married when I was 20.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "59158FAB56",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 26,
        "text": "That's my daughter and me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F201CC91B5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 18,
        "text": "She's still there.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "09A2AA0062",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 35,
        "text": "She's there this morning, actually.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7A46C1E9B3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 16,
        "text": "That's my house.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A575D8A705",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 56,
        "text": "My family's living in the Hilton Hotel in Scotts Valley.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9B8B13D9C4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 59,
        "text": "That's my wife, Heidi, who didn't take it as well as I did.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9FE8DFA0D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 0,
        "endOffset": 29,
        "text": "My children, Davey and Henry.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "331F70DE30",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 43,
        "text": "My son, Davey, in the hotel two nights ago.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "97A8BD55D5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 107,
        "text": "So, my message to you folks, from my three minutes, is that I appreciate the chance to share this with you.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "C4CB3F848A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 15,
        "text": "I will be back.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CF7F2C7CE3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 20,
        "text": "I love being at TED.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FEC48B66E8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 38,
        "text": "I came to live it, and I am living it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B9518E01D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 92,
        "text": "That's my view from my window outside of Santa Cruz, in Bonny Doon, just 35 miles from here.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AFC8084BC9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 20,
        "text": "Thank you everybody.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6C0A312CD3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "01800573B8",
      "from_name": "label",
