  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I had a fire nine days ago.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "98A7ECAA3D",
      "from_name": "label",
      "to_name": "text",
