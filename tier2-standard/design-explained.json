    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 228,
        "text": "It is easy to forget the gasp-inducement that occurred in 2007 when you first touched this thing because it became so quickly pervasive and because of how instantly we adopted these gestures and made it an extension of our life.",
        "paragraphlabels": [
          "NONE"
        ]
