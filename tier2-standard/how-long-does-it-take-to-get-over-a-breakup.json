      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 49,
        "text": "Well, unfortunately, it's not so straightforward.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "71FEB3D17D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 58,
        "text": "See, those articles drastically misrepresented that study.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CCFD747711",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 85,
        "text": "In fact, the study never said anything about how long it takes to get over a breakup.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "856AE17E2D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
