    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 108,
        "text": "Well, we have more -- Within just two years' time, we now have more demand for our homes than we have homes.",
        "paragraphlabels": [
