    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 8,
        "text": "You have",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E7A8296826",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
