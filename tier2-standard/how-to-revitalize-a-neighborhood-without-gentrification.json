    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 31,
        "text": "You'd want to live here, right?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "E780CF77D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 77,
        "endOffset": 92,
        "text": "Black Butterfly",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A627D8A9B8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 34,
        "text": "Somehow the market must be broken.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "CD9DB1A858",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 6,
        "text": "Right?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "5480CA5FFE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 21,
        "text": "What's going on here?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "89BC635EC7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 88,
        "text": "I’ve been studying the way housing markets work -- or don’t work -- for the last decade.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5AEDF1173D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 183,
        "text": "I started my career in investment finance on Wall Street, but when my hometown on the outskirts of New York City began to be gentrified, it pushed me into becoming a housing advocate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2C17CE3132",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 25,
        "endOffset": 40,
        "text": "racist policies",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "30862FFAA9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 88,
        "endOffset": 97,
        "text": "redlining",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F3261590DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 102,
        "endOffset": 115,
        "text": "urban renewal",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B093CAD6C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 50,
        "text": "The first is a downward spiral, where political and financial disinvestment causes hypervacancy and decay that pushes people out of a neighborhood.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "2373CD05C9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 15,
        "endOffset": 30,
        "text": "downward spiral",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3D289D4406",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 71,
        "endOffset": 100,
        "text": "risky, defeated, unredeemable",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B33D9366F6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 59,
        "text": "And so without investment, the cycle of distress continues.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1BD966DBA5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 304,
        "text": "capitaliz[e] off of this distress",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "65B56D4B34",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 202,
        "endOffset": 218,
        "text": "legacy residents",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B0F70928D0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 258,
        "endOffset": 281,
        "text": "much, much higher costs",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "EF1443DAB6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 66,
        "text": "So my question became: Can we do development without displacement?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "346B4CE180",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Is there another way?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "4762A338E1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 53,
        "endOffset": 84,
        "text": "the city that birthed redlining",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "7BE5871DD5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 53,
        "endOffset": 61,
        "text": "you know",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "718E36C6EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 44,
        "text": "And I was literally laughed out of the room.",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "A2DA8009C1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 108,
        "text": "They said that my idea was impossible and that we would build homes that would sit empty for lack of demand.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8387321AE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 11,
        "endOffset": 32,
        "text": "in my heart of hearts",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "EE911774DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 29,
        "endOffset": 100,
        "text": "being rejected by investors was the most important moment in my journey",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FE4D4E4194",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 126,
        "endOffset": 196,
        "text": "we didn't need big institutions to affirm the value of our communities",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "F3202B95EE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 49,
        "text": "We’d affirm our own value through social capital.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6509E80471",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 192,
        "text": "And so I started my non-profit, Parity, which creates upfront demand for homeownership opportunities in neighborhoods experiencing hypervacancy simply by tapping into existing social networks.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AB777A5C7A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 122,
        "text": "All through word of mouth.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "6546C20496",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 26,
        "text": "And we have a waitlist of over -- (Applause) Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A792CD0896",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 45,
        "endOffset": 55,
        "text": "Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1AB5142E1E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 10,
        "text": "And we now have a waitlist of over 100 people wanting to join our intentional community.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4F0B8E9544",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 43,
        "endOffset": 57,
        "text": "leave a legacy",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6630B7F444",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 76,
        "text": "Like Yolanda, who's ready to buy a home to leave a legacy for her daughters.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2FF64EA6F4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 121,
        "endOffset": 139,
        "text": "highway to nowhere",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A6DF5DF4CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 140,
        "text": "Or Jenee, a fourth-generation Baltimorean whose father vividly remembers the demolition of black homes to make way for a highway to nowhere.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "805581ADA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 138,
        "text": "Ako, whose family left West Baltimore when he was just a baby but now is coming back home to his origins to be part of the revitalization.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3A6074BD48",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 92,
        "text": "And Modinat, who like me, came to Baltimore from New York to settle down and build a future.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "92418D8B04",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 61,
        "text": "There are three key reasons why our work is transformational.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4F2F944E8E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 129,
        "endOffset": 146,
        "text": "deeply affordable",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B0C62871D6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 160,
        "text": "The first is that we are leading the purchase and renovation of dozens of decades-long abandoned buildings and reselling them at deeply affordable price points.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8DE2272848",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 158,
        "endOffset": 175,
        "text": "deep social bonds",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "CD48E0B280",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 220,
        "text": "The second is that we not only support our homebuyers to become credit-qualified and mortgage-approved, but we're creating the opportunity for folks to build deep social bonds and friendships with their future neighbors.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "40917A62C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 9,
        "text": "And three",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "18464A9A0F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 193,
        "text": "And three, we're preventing the displacement of legacy residents by ensuring that they have the resources that they need to stay in their homes and transfer their wealth to the next generation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CBCF7DB6AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 6,
        "endOffset": 31,
        "text": "healing the social fabric",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "C3EF27D052",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 61,
        "endOffset": 93,
        "text": "rebuilding the built environment",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3D2F42D066",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 52,
        "endOffset": 71,
        "text": "as we're rebuilding",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "902863A46D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 139,
        "text": "Contrary to the dominant narrative, there absolutely is demand for housing in historically Black neighborhoods devastated by racist policy.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0F87AEA875",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 20,
        "endOffset": 39,
        "text": "hunger and appetite",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1BF6D1485D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 54,
        "endOffset": 65,
        "text": "blind spots",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FBC85CB134",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 101,
        "text": "We've tapped into a hunger and appetite hiding in the blind spots of the traditional capital markets.",
        "paragraphlabels": [
          "NONE"
        ]
