{
  "project_id": 21,
  "project_label": "gemma",
  "task_id": 9331,
  "title": "The discoveries awaiting us in the ocean's twilight zone",
  "author": "Heidi M. Sosik",
  "url": "https://www.ted.com/talks/heidi_m_sosik_the_discoveries_awaiting_us_in_the_ocean_s_twilight_zone",
  "annotation_id": null,
  "completed_by": 7,
  "created_at": "2026-05-07T08:32:37.794453Z",
  "updated_at": "2026-05-07T08:32:37.794453Z",
  "lead_time": 67.907,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 29,
        "text": "I bet all of you are familiar",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "846644526D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 119,
        "text": "I bet all of you are familiar with this view of the ocean, but the thing is, most of the ocean looks nothing like this.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "093EC22629",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 44,
        "endOffset": 62,
        "text": "otherworldly realm",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "56947CE2FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 90,
        "text": "Below the sunlit surface waters, there's an otherworldly realm known as the twilight zone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E34AFB89BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 71,
        "text": "At 200 to 1,000 meters below the surface, sunlight is barely a glimmer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0AAB79E028",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 80,
        "endOffset": 94,
        "text": "give us a clue",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "3271A18CE1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 154,
        "text": "Tiny particles swirl down through the darkness while flashes of bioluminescence give us a clue that these waters teem with life: microbes, plankton, fish.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "508394722D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 101,
        "text": "Everything that lives here has amazing adaptations for the challenges of such an extreme environment.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4140590746",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 84,
        "text": "These animals help support top predators such as whales, tuna, swordfish and sharks.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "49F6564497",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 15,
        "endOffset": 28,
        "text": "10 times more",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "B30EF20A4A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 71,
        "text": "There could be 10 times more fish biomass here than previously thought.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "278ED1F710",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 9,
        "endOffset": 59,
        "text": "maybe more than all the rest of the ocean combined",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "A1EE271F36",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 60,
        "text": "In fact, maybe more than all the rest of the ocean combined.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BB82FF99EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 123,
        "text": "There are countless undiscovered species in deep waters, and life in the twilight zone is intertwined with earth's climate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C1BA1178BA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 46,
        "text": "Yet the twilight zone is virtually unexplored.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AF20B6C78A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 54,
        "text": "There are so many things we still don't know about it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3807C50748",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I think we can change that.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "69B09E892C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 59,
        "text": "I was drawn to oceanography by just this kind of challenge.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8CA753C6DF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 24,
        "endOffset": 44,
        "text": "perfect intersection",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "BFB3C5E8EA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 157,
        "text": "To me it represents the perfect intersection of science, technology and the unknown, the spark for so many breakthrough discoveries about life on our planet.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A507ECB4D1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 148,
        "text": "As a college student, I went on an expedition across the Atlantic with a team of scientists using a high-powered laser to measure microscopic algae.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EB298EF56E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 14,
        "text": "The wild thing",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1CC1438137",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 177,
        "text": "The wild thing that happened on that trip is that we discovered what everyone who looked before had completely missed: photosynthetic cells smaller than anyone thought possible.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "36F618285A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 85,
        "text": "We now know those tiny cells are the most abundant photosynthetic organisms on earth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0183A586E6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 101,
        "text": "This amazing discovery happened because we used new technology to see life in the ocean in a new way.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "96DB83DA44",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 77,
        "endOffset": 97,
        "text": "just as breathtaking",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "7D7F8BFA8C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 98,
        "text": "I am convinced that the discoveries awaiting us in the twilight zone will be just as breathtaking.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "939BC85504",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 74,
        "text": "We know so little about the twilight zone because it's difficult to study.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B3928B2CDB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 92,
        "text": "It's exceedingly large, spanning from the Arctic to the Southern Ocean and around the globe.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "85EDCD4BD5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 35,
        "text": "It's different from place to place.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "27C2963FDE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 49,
        "text": "It changes quickly as the water and animals move.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ED768BCC87",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 9,
        "endOffset": 31,
        "text": "deep and dark and cold",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "9D7D186197",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 70,
        "text": "And it's deep and dark and cold, and the pressures there are enormous.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F3AC1D9FD8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 31,
        "text": "What we do know is fascinating.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D36B3CFBF0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 20,
        "text": "You may be imagining",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "F830236FA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 123,
        "text": "You may be imagining huge monsters lurking in the deep sea, but most of the animals are very small, like this lantern fish.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "94CD570254",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 54,
        "text": "And this fierce-looking fish is called a bristlemouth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FF6B7AD182",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 17,
        "text": "Believe it or not",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "265E8D775A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 130,
        "text": "Believe it or not, these are the most abundant vertebrates on earth and many are so small that a dozen could fit in this one tube.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AB73D3902F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 110,
        "text": "It gets even more interesting, because small size does not stop them from being powerful through sheer number.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "FDA957E1F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 68,
        "text": "Deep, penetrating sonar shows us that the animals form dense layers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CB9A06F03C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 23,
        "text": "You can see what I mean",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "4B9FAAAB4B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 85,
        "text": "You can see what I mean by the red and yellow colors around 400 meters in these data.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2A41975357",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 48,
        "endOffset": 77,
        "text": "mistaken for the ocean bottom",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "19A4E90910",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 78,
        "text": "So much sound bounces off this layer, it's been mistaken for the ocean bottom.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3D7E690823",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 116,
        "endOffset": 129,
        "text": "day after day",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "EE76932AB1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 130,
        "text": "But if we look, it can't be, because the layer is deep during the day, it rises up at night and the pattern repeats day after day.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0634AEE72F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 55,
        "text": "This is actually the largest animal migration on earth.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "01830FA3A5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 80,
        "endOffset": 99,
        "text": "massive living wave",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D00D392053",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 264,
        "text": "It happens around the globe every day, sweeping through the world's oceans in a massive living wave as twilight zone inhabitants travel hundreds of meters to surface waters to feed at night and return to the relative safety of deeper, darker waters during the day.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E1CF66A91A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 92,
        "text": "These animals and their movements help connect the surface and deep ocean in important ways.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CB90047168",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 35,
        "endOffset": 87,
        "text": "they bring carbon in their food into the deep waters",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "67DAB5CF23",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 211,
        "text": "The animals feed near the surface, they bring carbon in their food into the deep waters, where some of that carbon can stay behind and remain isolated from the atmosphere for hundreds or even thousands of years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F705C374E8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 133,
        "text": "In this way, the migration may help keep carbon dioxide out of our atmosphere and limit the effects of global warming on our climate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0B869E9DB2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 33,
        "text": "But we still have many questions.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6CD8BE72F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 144,
        "text": "We don't know which species are migrating, what they're finding to eat, who is trying to eat them or how much carbon they are able to transport.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EAC25E7ADA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 49,
        "text": "So I'm a scientist who studies life in the ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "38254E0BEE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 99,
        "text": "For me, curiosity about these things is a powerful driver, but there's more to the motivation here.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2712F311E2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 57,
        "text": "We need to answer these questions and answer them quickly",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "8D226ACEF9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 101,
        "text": "We need to answer these questions and answer them quickly, because the twilight zone is under threat.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "044CC30404",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 42,
        "endOffset": 54,
        "text": "vacuuming up",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "26E4EBB190",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 128,
        "text": "Factory ships in the open ocean have been vacuuming up hundreds of thousands of tons of small, shrimp-like animals called krill.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1217381099",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 125,
        "text": "The animals are ground into fish meal to support increasing demands for aquaculture and for nutraceuticals such as krill oil.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CF387EE4A5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 111,
        "endOffset": 134,
        "text": "twilight zone gold rush",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "587FAC5D90",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 195,
        "text": "Industry is on the brink of deepening fisheries such as these into the mid-water in what could start a kind of twilight zone gold rush operating outside the reach of national fishing regulations.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "274FFD4CFA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 79,
        "text": "This could have irreversible global-scale impacts on marine life and food webs.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6D51A3D135",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 43,
        "text": "We need to get out ahead of fishing impacts",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3622AFDEE2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 99,
        "text": "We need to get out ahead of fishing impacts and work to understand this critical part of the ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1BD48CAE21",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 116,
        "text": "At Woods Hole Oceanographic Institution, I'm really fortunate to be surrounded by colleagues who share this passion.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CF4F418651",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 58,
        "text": "Together, we are ready to launch a large-scale exploration",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "C824A4BEF7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 80,
        "text": "Together, we are ready to launch a large-scale exploration of the twilight zone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4858F0E43C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 180,
        "text": "We have a plan to begin right away with expeditions in the North Atlantic, where we'll tackle the big challenges of observing and studying the twilight zone's remarkable diversity.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "15D837D188",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 98,
        "text": "This kind of multiscale, multidimensional exploration means we need to integrate new technologies.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EDCE9F2B6B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 15,
        "text": "Let me show you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "92CEA8EAF2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 63,
        "text": "Let me show you a recent example that has changed our thinking.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "92641D2217",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 147,
        "text": "Satellite tracking devices on animals such as sharks are now showing us that many top predators regularly dive deep into the twilight zone to feed.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D3A4A860D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 161,
        "text": "And when we map their swimming patterns and compare them to satellite data, we find that their feeding hot spots are linked to ocean currents and other features.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5512194701",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 73,
        "text": "We used to think these animals found all of their food in surface waters.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "43DA88EF68",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 48,
        "text": "We now believe they depend on the twilight zone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D872B0E434",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 153,
        "text": "But we still need to figure out how they find the best areas to feed, what they're eating there and how much their diets depend on twilight zone species.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B4D03276FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 69,
        "text": "We will also need new technologies to explore the links with climate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0B4B829A26",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 25,
        "text": "Remember these particles?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "6D7A47E5A9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 61,
        "text": "Some of them are produced by gelatinous animals called salps.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6D4E967B5A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 45,
        "text": "Salps are like superefficient vacuum cleaners",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F37496B691",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 114,
        "endOffset": 143,
        "text": "try saying that 10 times fast",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "C840F8E562",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 95,
        "endOffset": 201,
        "text": "pellets of poop -- try saying that 10 times fast -- pellets of poop that carry carbon deep into the ocean.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "637350C0FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 43,
        "text": "We sometimes find salps in enormous swarms.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F29CA60C3B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 16,
        "endOffset": 50,
        "text": "where and when and why and whether",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "E25F514A3B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 112,
        "text": "We need to know where and when and why and whether this kind of carbon sink has a big impact on earth's climate.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8B9D19C3CE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 72,
        "text": "To meet these challenges, we will need to push the limits of technology.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "379A12FFB6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 130,
        "text": "We will deploy cameras and samplers on smart robots to patrol the depths and help us track the secret lives of animals like salps.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DD0326ABEC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 88,
        "text": "We will use advanced sonar to figure out how many fish and other animals are down there.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C269DF10EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 0,
        "endOffset": 136,
        "text": "We will sequence DNA from the environment in a kind of forensic analysis to figure out which species are there and what they are eating.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "01C90FE3BF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 117,
        "text": "With so much that's still unknown about the twilight zone, there's an almost unlimited opportunity for new discovery.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0C28A8A7EC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 0,
        "endOffset": 52,
        "text": "Just look at these beautiful, fascinating creatures.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "230072D0CB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 20,
        "text": "We barely know them.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "72422E9BE4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 91,
        "text": "And imagine how many more are just down there waiting for our new technologies to see them.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BE191373F1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 113,
        "text": "The excitement level about this could not be higher on our team of ocean scientists, engineers and communicators.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EDE285F28E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 38,
        "text": "There is also a deep sense of urgency.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "999BDF6272",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 120,
        "text": "We can't turn back the clock on decades of overfishing in countless regions of the ocean that once seemed inexhaustible.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4493EB617A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 23,
        "text": "How amazing would it be",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "9F881A9E06",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 59,
        "text": "How amazing would it be to take a different path this time?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "86503D52FE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 17,
        "text": "The twilight zone",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "34E78B7443",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 44,
        "text": "The twilight zone is truly a global commons.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DC5326E34C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 110,
        "text": "We need to first know and understand it before we can be responsible stewards and hope to fish it sustainably.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5B5D4015AB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 43,
        "endOffset": 62,
        "text": "it is for all of us",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "84A5F806EE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 0,
        "endOffset": 188,
