    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 70,
        "endOffset": 75,
        "text": "Whoa!",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1F8D34CB4F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
