    },
    {
      "value": {
        "start": "99",
        "end": "99",
        "startOffset": 0,
        "endOffset": 146,
        "text": "Design is a way in which we can feel included in the world, but it is also a way in which we can uphold a person's dignity and their human rights.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BA57C4C126",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "100",
        "end": "100",
        "startOffset": 0,
        "endOffset": 79,
        "text": "Design can also inflict vulnerability on a group whose needs aren't considered.",
        "paragraphlabels": [
