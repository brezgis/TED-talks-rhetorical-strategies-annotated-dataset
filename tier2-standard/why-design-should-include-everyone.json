  "lead_time": 70.704,
  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 15,
        "endOffset": 18,
        "text": "you",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "63EBCDC306",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 33,
        "text": "That sounds grandiose, and it is.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "80361D0EA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 33,
        "text": "I left Ireland yesterday morning.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "7D854A5D31",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 49,
        "text": "I traveled from Dublin to New York independently.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EFB6AF620A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 49,
        "endOffset": 75,
        "text": "offers little independence",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1D1A2561EB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 81,
        "endOffset": 87,
        "text": "you're",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "7963D6BAB6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 28,
        "text": "For Americans, that's 3' 5'.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "64C0A4B326",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 72,
        "text": "I was whisked through the airport by airline assistants in a wheelchair.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F94A54B0FF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 141,
        "text": "Now, I don't need to use a wheelchair, but the design of an airport and its lack of accessibility means that it's my only way to get through.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "BC083432B4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 52,
        "endOffset": 116,
        "text": "through security, preclearance and I arrived at my boarding gate",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "7CDE60BCC4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 114,
        "text": "I use the accessibility services in the airport because most of the terminal is just not designed with me in mind.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AEB0B0774F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 27,
        "text": "Take security, for example.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1C46899025",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 78,
        "text": "I'm not strong enough to lift my carry-on bag from the ground to the carousel.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "69FE47E754",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 29,
        "text": "I stand at eye level with it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9D15F54874",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 92,
        "text": "And those who work in that space for safety purposes cannot help me and cannot do it for me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ECF29F38D9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 7,
        "endOffset": 47,
        "text": "inhibits my autonomy and my independence",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "64D9C90262",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 0,
        "endOffset": 45,
        "text": "But traveling at this size, it isn't all bad.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "32A9C1E16E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 47,
        "text": "The leg room in economy is like business class.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "6453FCB151",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 0,
        "endOffset": 51,
        "text": "(Laughter) I often forget that I'm a little person.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8C126C8A52",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 57,
        "text": "It's the physical environment and society that remind me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "14DB9881E3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 54,
        "text": "Using a public bathroom is an excruciating experience.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5F2FDCA9C4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 63,
        "text": "I walk into the cubicle but I can't reach the lock on the door.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F3FA595159",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 27,
        "text": "I'm creative and resilient.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CFC04809D3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 0,
        "endOffset": 67,
        "text": "I look around and see if there's a bin that I can turn upside down.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "18F6666DB1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 11,
        "text": "Is it safe?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "95BBFE30E3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 0,
        "endOffset": 11,
        "text": "Not really.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8258428D05",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 28,
        "text": "Is it hygienic and sanitary?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "16F6EE945C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 15,
        "text": "Definitely not.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B4D59578DB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 34,
        "text": "But the alternative is much worse.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A1AA022ACB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 37,
        "text": "If that doesn't work, I use my phone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "08B395093F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 99,
        "text": "It gives me an additional four- to six-inch reach, and I try to jam the lock closed with my iPhone.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5DE9FA9E76",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 7,
        "endOffset": 14,
        "text": "imagine",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "95A4E88AE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 94,
        "text": "Now, I imagine that's not what Jony Ive had in mind when he designed the iPhone, but it works.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "05936F214A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 46,
        "text": "The alternative is that I approach a stranger.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "73D6941E65",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 76,
        "text": "I apologize profusely and I ask them to stand guard outside my cubicle door.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "901E887A21",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 34,
        "endOffset": 54,
        "text": "absolutely mortified",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "7B93F41483",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 139,
        "text": "They do and I emerge grateful but absolutely mortified, and hope that they didn't notice that I left the bathroom without washing my hands.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B4712C3E46",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 128,
        "text": "I carry hand sanitizer with me every single day because the sink, soap dispenser, hand dryer and mirror are all out of my reach.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A6A327948C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 54,
        "text": "Now, the accessible bathroom is somewhat of an option.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8C5BA5932A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 49,
        "endOffset": 108,
        "text": "the sink, the soap dispenser, the hand dryer and the mirror",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "6416FD286A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 109,
        "text": "In this space, I can reach the lock on the door, the sink, the soap dispenser, the hand dryer and the mirror.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "82A073CDB4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Yet, I cannot use the toilet.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3E30D601C2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 90,
        "text": "It is deliberately designed higher so that wheelchair users can transfer across with ease.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "ADA8805648",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 145,
        "text": "This is a wonderful and necessary innovation, but in the design world, when we describe a new project or idea as accessible, what does that mean?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DDC8EBC978",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 24,
        "text": "Who is it accessible to?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "FFC61A0972",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 47,
        "text": "And whose needs are not being accommodated for?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "465E2185D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 197,
        "text": "Now, the bathroom is an example of where design impinges upon my dignity, but the physical environment impacts upon me in much more casual ways too, something as simple as ordering a cup of coffee.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "099FF9C2DD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 19,
        "text": "Now, I'll admit it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "42783EDAF6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 8,
        "endOffset": 27,
        "text": "far too much coffee",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "868B459729",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 28,
        "text": "I drink far too much coffee.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "526DCC90C6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 54,
        "endOffset": 79,
        "text": "wean myself off the syrup",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "B245EF124A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 80,
        "text": "My order is a skinny vanilla latte, but I'm trying to wean myself off the syrup.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "191FAA7C6B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 65,
        "text": "But the coffee shop, it's not designed well, at least not for me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "49F6E25795",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 89,
        "text": "Queuing, I'm standing beside the pastry cabinet and the barista calls for the next order.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2AE0C82611",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 15,
        "text": "\"Next, please!\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "69D8EB22F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 11,
        "text": "they shout.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8E2A2EC7F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 18,
        "text": "They can't see me.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B392B1A40C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 86,
        "text": "The person next to me in the queue points to my existence and everyone is embarrassed.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2EC337B30B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 64,
        "text": "I order as quick as I can and I move along to collect my coffee.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0C526F1557",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Now, think just for a second.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "90480F493D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 29,
        "text": "Now, think just for a second.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A997A725CA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Where do they put it?",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "15E48ED538",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 26,
        "text": "Up high and without a lid.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F619F09033",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 59,
        "endOffset": 90,
        "text": "incredibly dangerous experience",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "1E8F60811A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 91,
        "text": "Reaching up to collect a coffee that I have paid for is an incredibly dangerous experience.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2AB0D693A1",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 60,
        "text": "But design also impinges on the clothes that I want to wear.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D2E0263FCD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 44,
        "text": "I want garments that reflect my personality.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F5CA211D9F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 55,
        "text": "It's difficult to find in the childrenswear department.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "59649E7F23",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 55,
        "text": "And often womenswear requires far too many alterations.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "68DE7D4A5D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 18,
        "endOffset": 72,
        "text": "affect my maturity, professionalism and sophistication",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "0FD31AB556",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "62",
        "end": "62",
        "startOffset": 0,
        "endOffset": 68,
        "text": "Instead, I'm offered sneakers with Velcro straps and light-up shoes.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B3F8D0276F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "63",
        "end": "63",
        "startOffset": 0,
        "endOffset": 47,
        "text": "Now, I'm not totally opposed to light-up shoes.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F94C520B0D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "64",
        "end": "64",
        "startOffset": 0,
        "endOffset": 82,
        "text": "(Laughter) But design also impacts on such simple things, like sitting on a chair.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "10774CA61C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "65",
        "end": "65",
        "startOffset": 0,
        "endOffset": 61,
        "text": "I cannot go from a standing to a seating position with grace.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4ADAFCE148",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "66",
        "end": "66",
        "startOffset": 0,
        "endOffset": 178,
        "text": "Due to the standards of design heights of chairs, I have to crawl on my hands and knees just to get on top of it, whilst also being conscious that it might tip over at any stage.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8512273B8E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "67",
        "end": "67",
        "startOffset": 32,
        "endOffset": 91,
        "text": "whether it's a chair, a bathroom, a coffee shop, or clothes",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "F680D65A2C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "68",
        "end": "68",
        "startOffset": 0,
        "endOffset": 29,
        "text": "But not everybody is so nice.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DBB3D3C84E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "69",
        "end": "69",
        "startOffset": 54,
        "endOffset": 122,
        "text": "points, stares, laughs, calls me a name, or takes a photograph of me",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "8D1F83AF15",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "70",
        "end": "70",
        "startOffset": 0,
        "endOffset": 30,
        "text": "This happens almost every day.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D3EACD5367",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "71",
        "end": "71",
        "startOffset": 0,
        "endOffset": 230,
        "text": "With the rise of social media, it has given me an opportunity and a platform to have a voice as a blogger and as an activist, but it has also made me nervous that I might become a meme or a viral sensation, all without my consent.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "9C98D9F196",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "72",
        "end": "72",
        "startOffset": 0,
        "endOffset": 62,
        "text": "So let's take a moment right now to make something very clear.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "B4B2F580D2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "73",
        "end": "73",
        "startOffset": 0,
        "endOffset": 28,
        "text": "The word \"midget\" is a slur.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0A073F416E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "74",
        "end": "74",
        "startOffset": 0,
        "endOffset": 60,
        "text": "It evolved from PT Barnum's era of circuses and freak shows.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4CEDB82DE2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "75",
        "end": "75",
        "startOffset": 0,
        "endOffset": 20,
        "text": "Society has evolved.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AA622C7B0E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "76",
        "end": "76",
        "startOffset": 0,
        "endOffset": 25,
        "text": "So should our vocabulary.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E757AEF78C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "77",
        "end": "77",
        "startOffset": 0,
        "endOffset": 28,
        "text": "Language is a powerful tool.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2F436999BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "78",
        "end": "78",
        "startOffset": 0,
        "endOffset": 34,
        "text": "It does not just name our society.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "190E475675",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "79",
        "end": "79",
        "startOffset": 0,
        "endOffset": 13,
        "text": "It shapes it.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "A4BF3C5D91",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "80",
        "end": "80",
        "startOffset": 0,
        "endOffset": 95,
        "text": "I am incredibly proud to be a little person, to have inherited the condition of achondroplasia.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "1EF3A9BB92",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "81",
        "end": "81",
        "startOffset": 0,
        "endOffset": 33,
        "text": "But I am most proud to be Sinead.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "053CFD33BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "82",
        "end": "82",
        "startOffset": 0,
        "endOffset": 51,
        "text": "Achondroplasia is the most common form of dwarfism.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A72A0EA9AF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "83",
        "end": "83",
        "startOffset": 0,
        "endOffset": 59,
        "text": "Achondroplasia translates as \"without cartilage formation.\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "3BBD9C328E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "84",
        "end": "84",
        "startOffset": 0,
        "endOffset": 80,
        "text": "I have short limbs and achondroplastic facial features, my forehead and my nose.",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "C5F74E8197",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "85",
        "end": "85",
        "startOffset": 0,
        "endOffset": 57,
        "text": "My arms do not straighten fully, but I can lick my elbow.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "729E38B7AC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "86",
        "end": "86",
        "startOffset": 0,
        "endOffset": 29,
        "text": "I'm not showing you that one.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "63ED5EC4E9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "87",
        "end": "87",
        "startOffset": 0,
        "endOffset": 134,
        "text": "Achondroplasia occurs in approximately one in every 20,000 births. 80 percent of little people are born to two average-height parents.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6E050557C4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "88",
        "end": "88",
        "startOffset": 0,
        "endOffset": 76,
        "text": "That means that anybody in this room could have a child with achondroplasia.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "3A1BB43CAB",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "89",
        "end": "89",
        "startOffset": 0,
        "endOffset": 42,
        "text": "Yet, I inherited my condition from my dad.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D839E4097F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "90",
        "end": "90",
        "startOffset": 0,
        "endOffset": 42,
        "text": "I'd like to show you a photo of my family.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "5CD2B7BFD5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "91",
        "end": "91",
        "startOffset": 0,
        "endOffset": 95,
        "text": "My mother is average height, my father is a little person and I am the eldest of five children.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "355C096868",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "92",
        "end": "92",
        "startOffset": 0,
        "endOffset": 37,
        "text": "I have three sisters and one brother.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CFC38E488A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "93",
        "end": "93",
        "startOffset": 0,
        "endOffset": 28,
        "text": "They are all average height.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "38BDD65EAF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "94",
        "end": "94",
        "startOffset": 178,
        "endOffset": 233,
        "text": "armed me with the resilience, creativity and confidence",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "908E0468F8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "94",
        "end": "94",
        "startOffset": 58,
        "endOffset": 233,
        "text": "that cultivated my curiosity and my tenacity, that protected me from the unkindness and ignorance of strangers and that armed me with the resilience, creativity and confidence",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "A12520139C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "95",
        "end": "95",
        "startOffset": 130,
        "endOffset": 146,
        "text": "sass and sarcasm",
        "paragraphlabels": [
          "HUMOR"
        ]
      },
      "id": "E7F9647C3D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "95",
        "end": "95",
        "startOffset": 0,
        "endOffset": 178,
        "text": "If I was to pinpoint any reason why I am successful, it is because I was and I am a loved child, now, a loved child with a lot of sass and sarcasm, but a loved child nonetheless.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A5A51FC999",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "96",
        "end": "96",
        "startOffset": 0,
        "endOffset": 85,
        "text": "In giving you an insight into who I am today I wanted to offer you a new perspective.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A89FCD691E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "97",
        "end": "97",
        "startOffset": 0,
        "endOffset": 87,
        "text": "I wanted to challenge the idea that design is but a tool to create function and beauty.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "C623DA1D4A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "98",
        "end": "98",
        "startOffset": 0,
        "endOffset": 54,
        "text": "Design greatly impacts upon people's lives, all lives.",
        "paragraphlabels": [
          "NONE"
        ]
      },
