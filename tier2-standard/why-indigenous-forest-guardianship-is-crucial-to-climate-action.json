  "result": [
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 68,
        "endOffset": 91,
        "text": "land of seven volcanoes",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "050BC0701A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "0",
        "end": "0",
        "startOffset": 0,
        "endOffset": 129,
        "text": "I come from a small island called Camiguin in southern Philippines, land of seven volcanoes and the famous sweet lanzones fruits.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "487F7E0BA0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "1",
        "end": "1",
        "startOffset": 0,
        "endOffset": 60,
        "text": "As a kid, I would go to the forest with my father, a healer.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "F4B2BEA8E0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "2",
        "end": "2",
        "startOffset": 0,
        "endOffset": 53,
        "text": "He would take me by the hand and whisper, \"Tabi apo!\"",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "54B676A531",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 1,
        "endOffset": 11,
        "text": "Permit me,",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "83C25109C0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 13,
        "endOffset": 30,
        "text": "to respect spirit",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "561ED991F6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "3",
        "end": "3",
        "startOffset": 0,
        "endOffset": 59,
        "text": "\"Permit me,\" to respect spirit, the majesty of giant trees.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "72CF815820",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 53,
        "endOffset": 80,
        "text": "Spirits, forests, lanzones.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "04715F96D4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "4",
        "end": "4",
        "startOffset": 0,
        "endOffset": 80,
        "text": "Often he would look me straight in the eye and say, \"Spirits, forests, lanzones.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E70D3B167A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "5",
        "end": "5",
        "startOffset": 0,
        "endOffset": 16,
        "text": "They nurture us.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AD01F6A66E",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "6",
        "end": "6",
        "startOffset": 0,
        "endOffset": 22,
        "text": "You nurture them back.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "0EA309B9CF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "7",
        "end": "7",
        "startOffset": 0,
        "endOffset": 38,
        "text": "You work with the people who know how.",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "CAE20B9C00",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "8",
        "end": "8",
        "startOffset": 0,
        "endOffset": 18,
        "text": "I share this pain.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4205042626",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 66,
        "endOffset": 93,
        "text": "cry of the world’s wildlife",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D27FD05DD4",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "9",
        "end": "9",
        "startOffset": 0,
        "endOffset": 172,
        "text": "Now seeing our world's tropical rainforests cut down, hearing the cry of the world’s wildlife, losing their habitats, listening to reports of forest guardians under threat.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DA936F1DFE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "10",
        "end": "10",
        "startOffset": 0,
        "endOffset": 67,
        "text": "In 2020, over 200 Indigenous and environmental defenders were lost.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AEE682BAFA",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "11",
        "end": "11",
        "startOffset": 0,
        "endOffset": 78,
        "text": "Illegal loggers, illegal logging is linked to almost a third of these murders.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "CE1CBB3F75",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 26,
        "endOffset": 42,
        "text": "death of forests",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "D4480FF5B2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "12",
        "end": "12",
        "startOffset": 0,
        "endOffset": 73,
        "text": "With their deaths and the death of forests, something is also lost in us.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2027C2F40D",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "13",
        "end": "13",
        "startOffset": 0,
        "endOffset": 44,
        "text": "Our abilities to survive the climate crisis.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "17F2E2A2B2",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "14",
        "end": "14",
        "startOffset": 0,
        "endOffset": 21,
        "text": "Pressure is building.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D0AD983106",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 134,
        "endOffset": 163,
        "text": "guardians of standing forests",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FE8099F2EF",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "15",
        "end": "15",
        "startOffset": 52,
        "endOffset": 63,
        "text": "all say yes",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "5E8B1390B5",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "16",
        "end": "16",
        "startOffset": 0,
        "endOffset": 22,
        "text": "Finally, we all agree.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D66893513B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "17",
        "end": "17",
        "startOffset": 38,
        "endOffset": 58,
        "text": "in my father's words",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "FEB20F5196",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "18",
        "end": "18",
        "startOffset": 0,
        "endOffset": 141,
        "text": "Over 20 years ago in my own hometown in southern Philippines, Indigenous peoples, activists, all put their own lives on the line as fighters.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "84686A14C7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "19",
        "end": "19",
        "startOffset": 0,
        "endOffset": 101,
        "text": "They protect their forests against illegal loggers, companies and miners who want to take their land.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E4E0479286",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "20",
        "end": "20",
        "startOffset": 0,
        "endOffset": 71,
        "text": "My own fiancée, a brave Indigenous young man, was killed in that fight.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E5D6DEC3B3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "21",
        "end": "21",
        "startOffset": 0,
        "endOffset": 36,
        "text": "For years, I thought I was a coward.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "126719AB7F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "22",
        "end": "22",
        "startOffset": 21,
        "endOffset": 47,
        "text": "chose the pen, not the gun",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "1B56939E3F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "23",
        "end": "23",
        "startOffset": 0,
        "endOffset": 110,
        "text": "I chose to set up a legal defense organization, stood with brave Indigenous women and men as barefoot lawyers.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DF92F11C41",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "24",
        "end": "24",
        "startOffset": 52,
        "endOffset": 81,
        "text": "Can we really trust the laws?",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "FD20CA1754",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "25",
        "end": "25",
        "startOffset": 0,
        "endOffset": 28,
        "text": "I barely had time to ponder.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8B0B3B0E87",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "26",
        "end": "26",
        "startOffset": 0,
        "endOffset": 7,
        "text": "You see",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "8024951F51",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "27",
        "end": "27",
        "startOffset": 0,
        "endOffset": 71,
        "text": "So we set up quick reaction teams to respond 24/7 to their legal needs.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4EAE814E22",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "28",
        "end": "28",
        "startOffset": 0,
        "endOffset": 184,
        "text": "And this work led to the passage of an ancestral domain law in the Philippines that set up an Indigenous People's Commission and recognized 4 million hectares of ancestral land claims.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6CE9AD345C",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "29",
        "end": "29",
        "startOffset": 0,
        "endOffset": 211,
        "text": "This -- (Applause) was shared through Indonesia's legal aid and legal rights defenders who work and strengthen the Indonesia’s Alliance of Indigenous Peoples, and they won their forest land rights case in court.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0B20E3DC5A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 44,
        "endOffset": 54,
        "text": "look after",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "2194F64CC7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "30",
        "end": "30",
        "startOffset": 0,
        "endOffset": 94,
        "text": "Today 476-million-strong Indigenous peoples look after 80 percent of our world’s biodiversity.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4E0EF1239F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "31",
        "end": "31",
        "startOffset": 0,
        "endOffset": 47,
        "text": "So I joined the Tenure Facility five years ago.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D75ADE79E3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "32",
        "end": "32",
        "startOffset": 0,
        "endOffset": 167,
        "text": "Based in Stockholm, we finance mapping and legal defense of collective land rights, so communities globally can protect themselves, protect forests and protect nature.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EBE1456F56",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "33",
        "end": "33",
        "startOffset": 0,
        "endOffset": 21,
        "text": "This is how we do it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4A2C9D13B9",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "34",
        "end": "34",
        "startOffset": 0,
        "endOffset": 182,
        "text": "We work with credible communities who are forest guardians positioned to protect large tracts of tropical rainforest in the Amazon and Central America, Congo Basin and tropical Asia.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "0188389CB3",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "35",
        "end": "35",
        "startOffset": 0,
        "endOffset": 105,
        "text": "And in these countries, laws and policies already exist to recognize rights, but they're not implemented.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "E616B8580F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "36",
        "end": "36",
        "startOffset": 0,
        "endOffset": 120,
        "text": "Because communities and their partners in government lack support, funding and capacity to turn this promise to reality.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "77D3678E4B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "37",
        "end": "37",
        "startOffset": 0,
        "endOffset": 287,
        "text": "For example, in Panama, we assisted the Federation of Indigenous Peoples COONAPIP and their ally in government, and now they've recognized 200,000 hectares of their Indigenous lands, and today they protect a million hectares of Indigenous people’s lands and forests, and they monitor it.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A318E2AE52",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "38",
        "end": "38",
        "startOffset": 0,
        "endOffset": 112,
        "text": "In Liberia, we worked with 24 customary communities and their allies in government and women land rights groups.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "53C93CE7C0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "39",
        "end": "39",
        "startOffset": 0,
        "endOffset": 88,
        "text": "And they now recognize and protect 600,000 hectares of their customary land and forests.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "93E332A5FC",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "40",
        "end": "40",
        "startOffset": 0,
        "endOffset": 193,
        "text": "In Indonesia, we assisted the Alliance of Indigenous Peoples, and farmers and women, and they together recognized and registered 1.2 million hectares of their ancestral land claims and forests.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "6984B84C3A",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 61,
        "text": "And together they buffer large tracts of forest in Indonesia.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "301D99722F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "41",
        "end": "41",
        "startOffset": 0,
        "endOffset": 61,
        "text": "And together they buffer large tracts of forest in Indonesia.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "2D09A70175",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "42",
        "end": "42",
        "startOffset": 0,
        "endOffset": 120,
        "text": "Protecting rights to manage lands and forests is not only protecting biodiversity, it is also a climate change solution.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D6D241E3CD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "43",
        "end": "43",
        "startOffset": 0,
        "endOffset": 74,
        "text": "And it is a very powerful leverage to our world's climate mitigation work.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "42B055D739",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "44",
        "end": "44",
        "startOffset": 0,
        "endOffset": 88,
        "text": "And it is supporting the visions of intergenerational stewardship of Indigenous peoples.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "AA510A81F7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "45",
        "end": "45",
        "startOffset": 0,
        "endOffset": 28,
        "text": "We have shown it's possible.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "4945E73CA7",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "46",
        "end": "46",
        "startOffset": 0,
        "endOffset": 191,
        "text": "Today, since 2017, Indigenous peoples, our partners, have advanced recognition of their land rights and forests to up to 14 million hectares, benefitting seven million people in 12 countries.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B999005CDE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "47",
        "end": "47",
        "startOffset": 0,
        "endOffset": 141,
        "text": "And with TED’s Audacious support, we can leverage this momentum and expand, secure and protect up to 50 million hectares of land and forests.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "511985432B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "48",
        "end": "48",
        "startOffset": 0,
        "endOffset": 81,
        "text": "And reach -- (Applause) reach 50 million forest guardians in the next five years.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "EEA687F190",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 129,
        "endOffset": 135,
        "text": "bridge",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "F59F9E0C94",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "49",
        "end": "49",
        "startOffset": 0,
        "endOffset": 136,
        "text": "What we've learned is that when in the midst of environmental destruction, conflict and criminalization, land tenure serves as a bridge.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B243AC2BB0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 19,
        "endOffset": 23,
        "text": "link",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "C1BBFA80C8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 59,
        "endOffset": 83,
        "text": "opening minds and hearts",
        "paragraphlabels": [
          "FIG"
        ]
      },
      "id": "20E0F3D45B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "50",
        "end": "50",
        "startOffset": 0,
        "endOffset": 222,
        "text": "It is an important link that generates this possibility of opening minds and hearts for unusual parties, Indigenous peoples, governments, private sector, to come together to find a common solution for a sustainable planet.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "27D137AE89",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "51",
        "end": "51",
        "startOffset": 0,
        "endOffset": 74,
        "text": "Already with secure tenure, we see conflicts resolved, less deforestation.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "A0D3CD6439",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "52",
        "end": "52",
        "startOffset": 0,
        "endOffset": 28,
        "text": "And most importantly, women.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5C9FED3FEE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 68,
        "endOffset": 170,
        "text": "holders of traditional knowledge and as decision makers for land use, keepers of traditional knowledge",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "6D1828A962",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "53",
        "end": "53",
        "startOffset": 0,
        "endOffset": 171,
        "text": "Women have increased support for their role as forest guardians, as holders of traditional knowledge and as decision makers for land use, keepers of traditional knowledge.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "B6D20B44AE",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "54",
        "end": "54",
        "startOffset": 0,
        "endOffset": 48,
        "text": "And our youth, Indigenous youth are coming home.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "D394CE14D8",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "55",
        "end": "55",
        "startOffset": 0,
        "endOffset": 86,
        "text": "(Applause) My journey with Indigenous peoples has taught me deep humility and respect.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "39C4CB3152",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 167,
        "endOffset": 178,
        "text": "your chance",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "21274AA146",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 180,
        "endOffset": 189,
        "text": "my chance",
        "paragraphlabels": [
          "ENG"
        ]
      },
      "id": "13B474A5BD",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "56",
        "end": "56",
        "startOffset": 0,
        "endOffset": 212,
        "text": "Knowing the dangers of protecting forests they persist, they put their own families, their culture, their own lives on the line in order to secure our world's chance, your chance, my chance, for a livable future.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "488AB9F3D0",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "57",
        "end": "57",
        "startOffset": 0,
        "endOffset": 45,
        "text": "No one should have to die protecting forests.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "8D38C5E931",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 33,
        "endOffset": 144,
        "text": "to stand as allies, to protect the protectors of our future, to restore balance, to survive the climate crisis.",
        "paragraphlabels": [
          "REP"
        ]
      },
      "id": "904544F883",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "58",
        "end": "58",
        "startOffset": 0,
        "endOffset": 144,
        "text": "We all have a choice, all of us, to stand as allies, to protect the protectors of our future, to restore balance, to survive the climate crisis.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "DDECB65DE6",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "59",
        "end": "59",
        "startOffset": 0,
        "endOffset": 41,
        "text": "Let us work with the people who know how.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "5239867F75",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "60",
        "end": "60",
        "startOffset": 0,
        "endOffset": 10,
        "text": "Thank you.",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "472327C46B",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    },
    {
      "value": {
        "start": "61",
        "end": "61",
        "startOffset": 0,
        "endOffset": 10,
        "text": "(Applause)",
        "paragraphlabels": [
          "NONE"
        ]
      },
      "id": "73FE073A1F",
      "from_name": "label",
      "to_name": "text",
      "type": "paragraphlabels",
      "origin": "manual"
    }
  ]
}